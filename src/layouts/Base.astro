---
import "@fontsource/dm-mono/latin-400.css";
import "@/styles/global.css";
import archivoUrl from "@/assets/fonts/archivo.woff2?url";
import serifUrl from "@/assets/fonts/fraunces.woff2?url";
import { PRICING_CONSTANTS } from "@/data/calculator";
import { chrome } from "@/data/fovea";

interface Props {
  title: string;
  description: string;
  schema?: object;
  ogImageAlt?: string;
}

const {
  title,
  description,
  schema,
  ogImageAlt = `Clovis Web Design — landing page $${PRICING_CONSTANTS.tiers.landing.price}, live in a week, you own it on day one.`
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#F7F2E8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content="Clovis Web Design" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='-10 -10 70 70'%3E%3Crect x='-10' y='-10' width='70' height='70' rx='35' fill='%2316232C'/%3E%3Cpath fill='%23F7F2E8' d='M49.49 20A25 25 0 1 0 49.49 30L39.14 30A15 15 0 1 1 39.14 20Z'/%3E%3C/svg%3E"
    />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="paper relative min-h-screen text-ink">
    <div class="grain pointer-events-none fixed inset-0 z-[60] opacity-70" aria-hidden="true"></div>

    <!-- A real ruler that measures how far you've read. The numbers update on scroll; without script they rest at the top. -->
    <div data-ruler class="fixed inset-x-0 top-0 z-50 h-8 overflow-hidden border-b border-ink/12 bg-bone/85 backdrop-blur-md" aria-hidden="true">
      <div class="ruler-ticks absolute inset-x-0 bottom-0 h-[7px] opacity-40" style="--step:9px"></div>
      <div class="ruler-ticks absolute inset-x-0 bottom-0 h-[13px] opacity-70" style="--step:45px"></div>
      <div class="absolute bottom-0 left-1/2 h-[13px] w-[45px] -translate-x-1/2 bg-vermilion/80"></div>
      <div class="absolute top-1 left-3 flex items-center gap-2 bg-bone/90 px-1">
        <span class="label hidden text-muted sm:inline">{chrome.depth}</span>
        <span data-depth class="tightnum text-[0.6875rem] text-ink">0000mm</span>
      </div>
      <div class="absolute top-1 right-3 flex items-center gap-2 bg-bone/90 px-1">
        <span class="label hidden text-muted sm:inline">{chrome.acuity}</span>
        <span data-acuity data-steps={JSON.stringify(chrome.steps)} class="tightnum text-[0.6875rem] text-vermilion">{chrome.steps[0]}</span>
      </div>
    </div>

    <slot />
  </body>
</html>

<style>
  .ruler-ticks {
    background-image: repeating-linear-gradient(to right, var(--color-ink) 0 1px, transparent 1px var(--step));
    background-position-x: calc(var(--d, 0) * -1px);
  }
</style>

<script>
  // Ruler: ticks slide as you scroll, depth reads in "mm" (a quarter of a pixel each), acuity steps down the chart.
  // Also feeds the homepage rail's progress dot. One passive listener, one update per frame.
  const ruler = document.querySelector<HTMLElement>("[data-ruler]");
  const depth = document.querySelector<HTMLElement>("[data-depth]");
  const acuity = document.querySelector<HTMLElement>("[data-acuity]");
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  if (ruler && depth && acuity) {
    const steps: string[] = JSON.parse(acuity.dataset.steps!);
    let queued = false;
    const update = () => {
      queued = false;
      const y = scrollY;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, y / max) : 0;
      ruler.style.setProperty("--d", (y / 4).toFixed(1));
      depth.textContent = `${String(Math.round(y / 4)).padStart(4, "0")}mm`;
      acuity.textContent = steps[Math.min(steps.length - 1, Math.floor(p * steps.length))];
      rail?.style.setProperty("--p", p.toFixed(3));
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    update();
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
  }

  // Scroll reveals: each [data-reveal] fades up once as it comes into view. Anything already on screen just shows.
  const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (reveals.length && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -12% 0px" }
    );
    for (const el of reveals) {
      const r = el.getBoundingClientRect();
      if (r.top < innerHeight && r.bottom > 0) el.classList.add("in", "now");
      else io.observe(el);
    }
    document.documentElement.classList.add("reveal-on");
  }
</script>
