---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import StickyCall from "@/components/StickyCall.astro";
import Icon from "@/components/Icon.astro";
import { caseStudies, type ExtendedCaseStudy } from "@/data/caseStudies";
import { formatSmsUri } from "@/data/calculator";
import { caseStudySchema } from "@/lib/schema";

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props as { study: ExtendedCaseStudy };
const siteUrl = study.url;
const psi = `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(siteUrl)}&form_factor=mobile`;
const richResults = `https://search.google.com/test/rich-results?url=${encodeURIComponent(siteUrl)}`;
const chapter = "font-mono text-xs font-bold uppercase tracking-widest text-clay";
---

<Base title={`${study.client} case study — Clovis Web Design`} description={study.summary} schema={caseStudySchema(study)}>
  <Nav />
  <main class="mx-auto max-w-3xl px-4 pt-32 pb-24 sm:px-6 sm:pt-36">
    <nav aria-label="Breadcrumb" class="flex items-center text-xs text-stone">
      <a
        href="/#work"
        class="inline-flex min-h-[48px] min-w-[48px] items-center justify-center px-2 underline underline-offset-4 hover:text-clay focus:outline-none focus:ring-1 focus:ring-clay"
      >
        Work
      </a>
      <span aria-hidden="true" class="px-1"> / </span>
      <span class="truncate">{study.client}</span>
    </nav>

    <header class="mt-6 border-b border-ink/10 pb-10">
      <div class="flex flex-wrap items-center gap-3">
        <span
          class="rounded-full px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider"
          style={{ backgroundColor: study.accentSoft, color: study.accent }}
        >
          {study.tag}
        </span>
        <span class="font-mono text-xs text-stone">{study.location} · {study.year}</span>
      </div>
      <h1 class="mt-4 font-serif text-4xl font-bold text-ink sm:text-5xl">{study.client}</h1>
      <p class="mt-3 font-serif text-lg italic text-stone sm:text-xl">{study.headline}</p>
      <p class="mt-5 text-base text-ink-soft leading-relaxed">{study.summary}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={siteUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-linen transition-colors hover:bg-clay"
        >
          Visit the live site <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
        <a
          href={psi}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[48px] items-center gap-2 rounded-full border border-ink/20 px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-clay hover:text-clay"
        >
          Test its speed on PageSpeed <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
      </div>
      {
        study.image && (
          <div class="mt-8 overflow-hidden rounded-2xl border border-ink/15 bg-paper-deep/50 shadow-xl">
            <div class="flex items-center justify-between border-b border-ink/10 bg-paper-deep/80 px-4 py-3">
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <div class="h-3 w-3 rounded-full border border-black/10 bg-[#ff5f56]/90" />
                <div class="h-3 w-3 rounded-full border border-black/10 bg-[#ffbd2e]/90" />
                <div class="h-3 w-3 rounded-full border border-black/10 bg-[#27c93f]/90" />
              </div>
              <div class="mx-2 flex max-w-xs flex-1 items-center justify-center rounded-md border border-ink/10 bg-paper/90 px-3 py-1 font-mono text-xs text-ink-soft shadow-2xs">
                <span class="truncate">{new URL(siteUrl).hostname}</span>
              </div>
              <span class="inline-flex items-center gap-1 rounded bg-olive/15 px-2.5 py-1 font-mono text-[11px] font-bold text-olive-deep">
                100 PSI
              </span>
            </div>
            <div class="relative aspect-16/9 overflow-hidden bg-paper-deep">
              <img
                src={study.image}
                alt={study.imageAlt || `${study.client} website interface showcase`}
                width={study.imageWidth || 1280}
                height={study.imageHeight || 720}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        )
      }
      {
        study.doctors && (
          <p class="mt-6 rounded-xl border border-ink/10 bg-paper-deep/40 p-4 text-xs text-ink-soft">
            <span class="font-mono font-bold uppercase tracking-wider text-ink">Physicians: </span>
            {study.doctors.join(" · ")}
          </p>
        )
      }
      {
        study.founders && (
          <p class="mt-6 rounded-xl border border-ink/10 bg-paper-deep/40 p-4 text-xs text-ink-soft">
            <span class="font-mono font-bold uppercase tracking-wider text-ink">Owners: </span>
            {study.founders}
          </p>
        )
      }
    </header>

    <section class="mt-10 border-b border-ink/10 pb-10" aria-labelledby="problem">
      <span class={chapter}>01</span>
      <h2 id="problem" class="mt-2 font-serif text-2xl font-bold text-ink">The problem</h2>
      <p class="mt-4 font-serif text-lg font-medium text-ink-soft">{study.challenge.headline}</p>
      <p class="mt-3 text-sm text-ink-soft leading-relaxed sm:text-base">{study.challenge.body}</p>
      <ul class="mt-6 space-y-2 rounded-2xl border border-clay/20 bg-clay/5 p-6">
        {
          study.challenge.pains.map((pain) => (
            <li class="flex items-start gap-2.5 text-sm text-ink-soft leading-relaxed">
              <Icon name="x" class="mt-1 h-3.5 w-3.5 shrink-0 text-clay" />
              <span>{pain}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10 border-b border-ink/10 pb-10" aria-labelledby="build">
      <span class={chapter}>02</span>
      <h2 id="build" class="mt-2 font-serif text-2xl font-bold text-ink">What I built</h2>
      <p class="mt-4 font-serif text-lg font-medium text-ink-soft">{study.solution.headline}</p>
      <p class="mt-3 text-sm text-ink-soft leading-relaxed sm:text-base">{study.solution.body}</p>
      <div class="mt-6 space-y-4">
        {
          study.solution.moves.map((move) => (
            <div class="rounded-2xl border border-ink/10 bg-linen/90 p-5">
              <h3 class="font-serif text-base font-bold text-ink">{move.title}</h3>
              <p class="mt-1.5 text-sm text-ink-soft leading-relaxed">{move.detail}</p>
            </div>
          ))
        }
      </div>
      {
        study.hipaaArchitecture && (
          <dl class="mt-6 grid grid-cols-1 gap-3 rounded-2xl border border-olive/30 bg-olive/5 p-6 sm:grid-cols-3">
            <div class="rounded-xl bg-paper p-3 text-center">
              <dt class="text-[11px] font-mono uppercase text-stone">Referral fax</dt>
              <dd class="mt-1 font-serif text-sm font-bold text-ink">{study.hipaaArchitecture.referralFax}</dd>
            </div>
            <div class="rounded-xl bg-paper p-3 text-center">
              <dt class="text-[11px] font-mono uppercase text-stone">Scheduling line</dt>
              <dd class="mt-1 font-serif text-sm font-bold text-ink">{study.hipaaArchitecture.schedulingPhone}</dd>
            </div>
            <div class="rounded-xl bg-paper p-3 text-center">
              <dt class="text-[11px] font-mono uppercase text-stone">Web forms collecting patient data</dt>
              <dd class="mt-1 font-serif text-sm font-bold text-olive">{study.hipaaArchitecture.webPhiForms}</dd>
            </div>
          </dl>
        )
      }
    </section>

    <section class="mt-10 border-b border-ink/10 pb-10" aria-labelledby="result">
      <span class={chapter}>03</span>
      <h2 id="result" class="mt-2 font-serif text-2xl font-bold text-ink">The result</h2>
      {study.outcome && <p class="mt-4 font-serif text-lg font-medium text-ink-soft">{study.outcome}</p>}
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          study.metrics.map((m) => (
            <div class="rounded-2xl border border-ink/10 bg-paper-deep/60 p-4 text-center">
              <span class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-3xl">
                {m.prefix}
                {m.value}
                {m.suffix}
              </span>
              <span class="mt-1 block text-[11px] font-medium text-stone leading-tight">{m.label}</span>
            </div>
          ))
        }
      </div>
      <blockquote class="mt-8 rounded-2xl border-l-4 border-clay bg-paper-deep/50 p-6">
        <p class="font-serif text-base italic text-ink sm:text-lg leading-relaxed">&ldquo;{study.quote.text}&rdquo;</p>
        <footer class="mt-4">
          <span class="block font-serif font-bold text-ink">{study.quote.name}</span>
          <span class="block text-xs text-stone">{study.quote.role} · {study.quote.entity || study.client}</span>
        </footer>
      </blockquote>
    </section>

    <section class="mt-10" aria-labelledby="markup">
      <span class={chapter}>04</span>
      <h2 id="markup" class="mt-2 font-serif text-2xl font-bold text-ink">What Google reads</h2>
      <p class="mt-3 text-sm text-ink-soft leading-relaxed">
        Structured data is the part of a site that tells search engines who the business is, where it works and how to
        reach it. Google&rsquo;s own tool will show you what it finds on {new URL(siteUrl).hostname} today.
      </p>
      <a
        href={richResults}
        target="_blank"
        rel="noopener"
        class="mt-4 inline-flex min-h-[48px] items-center gap-2 rounded-full border border-ink/20 px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-clay hover:text-clay"
      >
        Open Google&rsquo;s Rich Results Test <Icon name="arrow-up-right" class="h-4 w-4" />
      </a>
    </section>

    <div class="mt-14 rounded-3xl border border-clay/30 bg-linen p-8 text-center">
      <p class="font-serif text-2xl font-bold text-ink">Want one like this?</p>
      <p class="mt-2 text-sm text-ink-soft">Call or text me. You'll get the person who built this one.</p>
      <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="tel:+15595753014"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-semibold text-linen hover:bg-clay"
        >
          <Icon name="phone" class="h-4 w-4" /> Call (559) 575-3014
        </a>
        <a
          href={formatSmsUri()}
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full border border-ink/20 px-6 py-3 text-sm font-semibold text-ink hover:border-clay hover:text-clay"
        >
          <Icon name="message" class="h-4 w-4" /> Text me
        </a>
      </div>
    </div>
  </main>
  <Footer />
  <StickyCall />
</Base>
