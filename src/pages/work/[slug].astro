---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import StickyCall from "@/components/StickyCall.astro";
import Icon from "@/components/Icon.astro";
import { caseStudies, srcsetFor, type ExtendedCaseStudy } from "@/data/caseStudies";
import { formatSmsUri } from "@/data/calculator";
import { caseStudyPage as t, work } from "@/data/fovea";
import { caseStudySchema } from "@/lib/schema";
import type { Metric } from "@/types";

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props as { study: ExtendedCaseStudy };
const host = new URL(study.url).hostname.replace(/^www\./, "");
const psi = `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(study.url)}&form_factor=mobile`;
const richResults = `https://search.google.com/test/rich-results?url=${encodeURIComponent(study.url)}`;
const fmt = (m: Metric) => `${m.prefix ?? ""}${m.value.toFixed(m.decimals ?? 0)}${m.suffix ?? ""}`;
const chapter = "label text-cobalt";
const h2 = "mt-2 text-4xl leading-none text-ink sm:text-5xl";
---

<Base title={`${study.client} case study — Clovis Web Design`} description={study.summary} schema={caseStudySchema(study)}>
  <Nav />
  <main class="mx-auto w-full max-w-[1100px] px-4 pt-32 pb-24 sm:px-6 sm:pt-40">
    <nav aria-label="Breadcrumb" class="label flex items-center text-muted">
      <a href="/#work" class="inline-flex min-h-[48px] min-w-[48px] items-center underline underline-offset-4 hover:text-cobalt">{t.crumb}</a>
      <span aria-hidden="true" class="px-2">/</span>
      <span class="truncate">{study.client}</span>
    </nav>

    <header class="mt-4 border-b border-ink/15 pb-12">
      <p class="label text-muted">
        {work.record} № {study.index} · {study.location} · {study.year}
      </p>
      <h1 class="mt-3 text-[3rem] leading-[0.95] text-ink sm:text-7xl">{study.client}</h1>
      <p class="mt-4 max-w-3xl font-display text-2xl leading-snug text-ink-soft italic">{study.headline}</p>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink-soft">{study.summary}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={study.url}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-ink px-6 text-[0.9rem] font-semibold text-paper transition-colors hover:bg-cobalt"
        >
          {t.visit} <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
        <a
          href={psi}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[48px] items-center gap-2 rounded-full border border-ink/25 px-6 text-[0.9rem] font-semibold text-ink transition-colors hover:border-cobalt hover:text-cobalt"
        >
          {t.test} <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
      </div>

      <figure class="mt-10 overflow-hidden rounded-2xl border border-ink/15 bg-panel">
        <figcaption class="label border-b border-ink/10 px-4 py-3 text-muted">{host}</figcaption>
        <img
          src={study.image}
          srcset={srcsetFor(study.image)}
          sizes="(min-width: 1100px) 1100px, 100vw"
          alt={study.imageAlt}
          width={study.imageWidth}
          height={study.imageHeight}
          decoding="async"
          class="aspect-[16/9] h-auto w-full object-cover object-top"
        />
      </figure>

      {
        (study.doctors || study.founders) && (
          <p class="mt-6 text-ink-soft">
            <span class="label text-ink">{study.doctors ? t.doctors : t.owners}: </span>
            {study.doctors ? study.doctors.join(" · ") : study.founders}
          </p>
        )
      }
    </header>

    <div class="grid gap-x-12 lg:grid-cols-12">
      <section class="border-b border-ink/15 py-12 lg:col-span-12" aria-labelledby="problem">
        <p class={chapter}>01</p>
        <h2 id="problem" class={h2}>{t.complaint}</h2>
        <div class="mt-6 grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="font-display text-2xl leading-snug text-ink">{study.challenge.headline}</p>
            <p class="mt-4 leading-relaxed text-ink-soft">{study.challenge.body}</p>
          </div>
          <ul class="space-y-3 lg:col-span-5">
            {
              study.challenge.pains.map((pain) => (
                <li class="flex gap-3 border-t border-ink/15 pt-3 text-ink-soft">
                  <Icon name="x" class="mt-1 h-4 w-4 shrink-0 text-duo-red" />
                  <span class="leading-snug">{pain}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="border-b border-ink/15 py-12 lg:col-span-12" aria-labelledby="build">
        <p class={chapter}>02</p>
        <h2 id="build" class={h2}>{t.built}</h2>
        <p class="mt-6 max-w-3xl font-display text-2xl leading-snug text-ink">{study.solution.headline}</p>
        <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">{study.solution.body}</p>
        <ol class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            study.solution.moves.map((move, i) => (
              <li class="rounded-2xl border border-ink/15 bg-card p-5">
                <span class="label text-muted">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="mt-2 font-display text-2xl leading-tight text-ink">{move.title}</h3>
                <p class="mt-2 leading-relaxed text-ink-soft">{move.detail}</p>
              </li>
            ))
          }
        </ol>
        {
          study.hipaaArchitecture && (
            <dl class="mt-8 grid gap-4 rounded-2xl bg-ink p-6 text-paper sm:grid-cols-3">
              {[
                [t.hipaa.fax, study.hipaaArchitecture.referralFax],
                [t.hipaa.phone, study.hipaaArchitecture.schedulingPhone],
                [t.hipaa.forms, String(study.hipaaArchitecture.webPhiForms)],
              ].map(([label, value]) => (
                <div class="flex flex-col-reverse gap-2">
                  <dt class="label text-paper/70">{label}</dt>
                  <dd class="optotype text-2xl">{value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </section>

      <section class="border-b border-ink/15 py-12 lg:col-span-12" aria-labelledby="result">
        <p class={chapter}>03</p>
        <h2 id="result" class={h2}>{t.result}</h2>
        {study.outcome && <p class="mt-6 max-w-3xl font-display text-2xl leading-snug text-ink">{study.outcome}</p>}
        <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {
            study.metrics.map((m) => (
              <div class="flex flex-col-reverse gap-2 rounded-2xl border border-ink/15 bg-card p-4">
                <dt class="label text-muted">{m.label}</dt>
                <dd class="optotype text-3xl text-ink">{fmt(m)}</dd>
              </div>
            ))
          }
        </dl>
        <blockquote class="mt-10 border-l-2 border-cobalt pl-5">
          <p class="font-display text-2xl leading-snug text-ink italic sm:text-3xl">“{study.quote.text}”</p>
          <footer class="mt-4">
            <span class="block font-semibold text-ink">{study.quote.name}</span>
            <span class="label mt-1 block text-muted">{study.quote.role}</span>
          </footer>
        </blockquote>
      </section>

      <section class="py-12 lg:col-span-12" aria-labelledby="markup">
        <p class={chapter}>04</p>
        <h2 id="markup" class={h2}>{t.google}</h2>
        <p class="mt-5 max-w-3xl leading-relaxed text-ink-soft">{t.googleBody(host)}</p>
        <a
          href={richResults}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex min-h-[48px] items-center gap-2 rounded-full border border-ink/25 px-6 text-[0.9rem] font-semibold text-ink transition-colors hover:border-cobalt hover:text-cobalt"
        >
          {t.googleLink} <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
      </section>
    </div>

    <div class="mt-6 rounded-[28px] bg-ink p-8 text-center text-paper sm:p-12">
      <p class="font-display text-4xl leading-none">{t.ctaTitle}</p>
      <p class="mt-3 text-paper/80">{t.ctaBody}</p>
      <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={formatSmsUri()}
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-paper px-6 font-semibold text-ink hover:bg-cobalt hover:text-paper"
        >
          <Icon name="message" class="h-4 w-4" /> Text Adam
        </a>
        <a href="tel:+15595753014" class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full border border-paper/30 px-6 font-semibold hover:border-paper">
          <Icon name="phone" class="h-4 w-4" /> Call (559) 575-3014
        </a>
      </div>
    </div>
  </main>
  <Footer />
  <StickyCall />
</Base>
