---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import AcuityRail from "@/components/AcuityRail.astro";
import Hero from "@/components/Hero.astro";
import Ledger from "@/components/Ledger.astro";
import Work from "@/components/Work.astro";
import Process from "@/components/Process.astro";
import EyeExam from "@/components/EyeExam.astro";
import Practice from "@/components/Practice.astro";
import Pricing from "@/components/Pricing.astro";
import Letters from "@/components/Letters.astro";
import Reception from "@/components/Reception.astro";
import Faq from "@/components/Faq.astro";
import Footer from "@/components/Footer.astro";
import StickyCall from "@/components/StickyCall.astro";
import { homeSchema } from "@/lib/schema";
import { PRICING_CONSTANTS } from "@/data/calculator";
import { stats } from "@/data/fovea";

const landingPrice = `$${PRICING_CONSTANTS.tiers.landing.price}`;
---

<Base
  title={`Fresno Web Design — Clovis Web Design | ${landingPrice} landing pages, live in a week`}
  description={`Hand-built websites for Fresno, Clovis and Central Valley businesses. Landing page ${landingPrice}, live in a week, and you own it on day one. Call or text Adam Youssef at (559) 575-3014.`}
  schema={homeSchema()}
>
  <a
    href="#main"
    class="label sr-only focus:not-sr-only focus:fixed focus:top-12 focus:left-4 focus:z-[90] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-bone"
  >
    Skip to main content
  </a>

  <Nav />
  <AcuityRail />
  <main id="main">
    <Hero />
    <Ledger />
    <Work />
    <Process />
    <EyeExam />

    <!-- The butter strip: results so far, every number from the case studies. -->
    <section aria-label={stats.label} class="relative overflow-hidden border-b border-ink/12 bg-butter">
      <dl class="mx-auto grid max-w-[1500px] grid-cols-2 gap-x-6 gap-y-8 px-4 py-12 sm:px-6 md:grid-cols-4 md:py-16 lg:px-10">
        {
          stats.items.map((s, i) => (
            <div class="flex flex-col items-start" data-reveal>
              <dt class="label order-2 mt-3 max-w-[30ch] leading-relaxed text-ink-2">{s.k}</dt>
              <dd class="order-1 font-display text-[clamp(2.6rem,7vw,5.4rem)] leading-[0.85] text-ink">{s.n}</dd>
              <dd class="tightnum order-3 mt-4 text-[0.6875rem] text-ink-2" aria-hidden="true">
                0{i + 1}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <Practice />
    <Pricing />
    <Letters />
    <Reception />
    <Faq />
  </main>
  <Footer />
  <StickyCall />
</Base>

