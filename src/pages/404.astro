---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import { formatSmsUri } from "@/data/calculator";
import { notFound as t } from "@/data/fovea";
---

<Base title="Page not found — Clovis Web Design" description="That page doesn't exist.">
  <Nav />
  <main class="mx-auto flex min-h-[85vh] w-full max-w-[1440px] flex-col justify-center px-4 pt-28 sm:px-6 lg:px-10">
    <p class="label text-vermilion">{t.acuity}</p>
    <h1 class="t-h2 mt-4 max-w-4xl text-ink">
      {t.title}{" "}<em class="text-vermilion">{t.accent}</em>
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-2">{t.body}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-ink px-7 font-semibold text-bone hover:bg-vermilion">{t.home}</a>
      <a href={formatSmsUri()} class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-ink/25 px-7 font-semibold text-ink hover:border-vermilion hover:text-vermilion">
        Text Adam
      </a>
    </div>
  </main>
</Base>
