---
import SectionHead from "./SectionHead.astro";
import { services } from "@/data/services";
import { servicesHead } from "@/data/fovea";
---

<section id="services" class="scroll-mt-28 border-t border-ink/10 bg-panel py-24 sm:py-32" aria-labelledby="services-title">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-10">
    <SectionHead id="services-title" {...servicesHead} />

    <ol class="mt-14 border-b border-ink/15">
      {
        services.map((s, i) => (
          <li class="grid gap-6 border-t border-ink/15 py-10 lg:grid-cols-12 lg:gap-10" data-reveal>
            <div class="lg:col-span-4">
              <span class="optotype text-lg text-cobalt">0{i + 1}</span>
              <h3 class="mt-3 text-[2.4rem] leading-none text-ink sm:text-5xl">{s.title}</h3>
              <p class="label mt-3 text-muted">{s.deliverableTag}</p>
            </div>
            <div class="lg:col-span-8">
              <p class="font-display text-2xl leading-snug text-ink">{s.subtitle}</p>
              <p class="mt-4 leading-relaxed text-ink-soft">{s.description}</p>
              {s.deliverables && (
                <ul class="mt-7 grid gap-5 sm:grid-cols-3">
                  {s.deliverables.map((d) => (
                    <li class="border-t-2 border-ink pt-3">
                      <span class="block font-semibold text-ink">{d.title}</span>
                      <span class="mt-1 block text-sm leading-relaxed text-ink-soft">{d.detail}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
