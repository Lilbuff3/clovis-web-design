---
// "What's in the case": the three things every build includes. Sits inside Fees; each row opens with native <details>.
import { services } from "@/data/services";
import { servicesHead as h } from "@/data/fovea";
---

<div id="services" class="mt-14 grid scroll-mt-28 grid-cols-1 gap-10 rounded-[26px] border border-ink/15 bg-bone p-7 sm:p-10 lg:grid-cols-12" data-reveal>
  <div class="lg:col-span-4">
    <p class="label flex items-center gap-3 text-muted">
      <span class="h-px w-5 bg-ink/25" aria-hidden="true"></span>
      {h.label}
    </p>
    <h3 class="mt-4 text-[clamp(1.6rem,3vw,2.2rem)] text-ink">
      {h.title}<br /><em class="accent">{h.accent}</em>
    </h3>
    <p class="mt-4 max-w-[36ch] text-[14.5px] leading-relaxed text-ink-2">{h.lede}</p>
  </div>
  <div class="lg:col-span-8">
    {
      services.map((s, i) => (
        <details class="group border-b border-ink/15 first:border-t">
          <summary class="flex min-h-[64px] cursor-pointer list-none items-baseline gap-4 py-4 [&::-webkit-details-marker]:hidden">
            <span class="tightnum text-[0.6875rem] text-vermilion">{String(i + 1).padStart(2, "0")}</span>
            <span class="flex-1">
              <span class="block font-display text-[1.45rem] leading-tight text-ink">{s.title}</span>
              <span class="mt-1 block text-[14.5px] leading-snug text-ink-2">{s.subtitle}</span>
            </span>
            <span
              class="grid h-9 w-9 shrink-0 place-items-center self-center rounded-full border border-ink/25 text-ink transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <div class="pb-6 pl-8">
            <p class="max-w-[65ch] text-[15px] leading-relaxed text-ink-2">{s.description}</p>
            {s.deliverables && (
              <ul class="mt-5 grid gap-4 sm:grid-cols-3">
                {s.deliverables.map((d) => (
                  <li class="border-t-2 border-ink pt-3">
                    <span class="block text-[15px] font-semibold text-ink">{d.title}</span>
                    <span class="mt-1 block text-[13.5px] leading-relaxed text-ink-2">{d.detail}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </details>
      ))
    }
  </div>
</div>
