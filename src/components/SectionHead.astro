---
// Section header, as in the original: a numbered eyebrow, a serif headline whose italic word sits on its own line,
// and the lede on the right. The acuity reading lives on the ruler and the side rail instead.
interface Props {
  id: string;
  n?: string;
  label: string;
  title: string;
  accent?: string;
  after?: string;
  lede?: string;
}
const { id, n, label, title, accent, after, lede } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-6 border-b border-ink/12 pb-6" data-reveal>
  <div>
    <p class="label flex items-center gap-3 text-muted">
      {n && <span class="tightnum text-vermilion">{n}</span>}
      <span class="h-px w-8 bg-ink/25" aria-hidden="true"></span>
      {label}
    </p>
    <h2 id={id} class="t-h2 mt-5 max-w-[18ch] text-ink">
      {title}
      {accent && <br />}
      {accent && <em>{accent}</em>}{after}
    </h2>
  </div>
  {lede && <p class="max-w-sm text-[15px] leading-relaxed text-ink-2">{lede}</p>}
</div>
