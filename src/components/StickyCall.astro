---
import Icon from "./Icon.astro";
import { formatSmsUri } from "@/data/calculator";
import { chrome } from "@/data/fovea";
---

<aside
  aria-label="Quick contact"
  class="fixed inset-x-0 bottom-0 z-40 block border-t border-ink/12 bg-bone/95 px-3 pt-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] shadow-[0_-12px_30px_-12px_rgba(22,35,44,0.25)] backdrop-blur-lg md:hidden"
>
  <div class="mx-auto flex max-w-lg items-center gap-2">
    <a
      href={formatSmsUri()}
      class="flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-full bg-ink px-3 whitespace-nowrap text-bone transition-transform active:scale-[0.98]"
    >
      <Icon name="message" class="h-4 w-4 shrink-0" />
      <span class="label">{chrome.textMe}</span>
    </a>
    <a
      href="tel:+15595753014"
      class="inline-flex min-h-[48px] min-w-[48px] items-center justify-center gap-1.5 rounded-full border border-ink/20 bg-card px-4 text-ink transition-transform active:scale-[0.98]"
    >
      <Icon name="phone" class="h-4 w-4 shrink-0 text-vermilion" />
      <span class="label">Call</span>
    </a>
    <a
      href="/#pricing"
      class="inline-flex min-h-[48px] min-w-[48px] items-center justify-center gap-1 rounded-full border border-ink/20 bg-card px-4 text-ink transition-transform active:scale-[0.98]"
    >
      <span class="label">Fees</span>
      <Icon name="arrow-up-right" class="h-3.5 w-3.5 shrink-0 text-vermilion" />
    </a>
  </div>
</aside>
