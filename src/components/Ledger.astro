---
import Mark from "./Mark.astro";
import SectionHead from "./SectionHead.astro";
import { duochrome as d } from "@/data/fovea";
---

<section id="ledger" class="scroll-mt-28 py-24 sm:py-32" aria-labelledby="ledger-title">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-10">
    <SectionHead id="ledger-title" {...d.head} />

    <!-- Red layer is clipped to --r; the range input on top moves it. Without script it sits at 50/50. -->
    <div class="duo relative mt-14 h-[470px] overflow-hidden rounded-[28px] border border-ink sm:h-[400px]" style="--r:50%" data-duo>
      <div class="absolute inset-0 bg-duo-green text-paper">
        <div class="ml-auto flex h-full w-1/2 flex-col p-4 sm:p-9">
          <p class="label text-paper">{d.green.note}</p>
          <h3 class="mt-2 text-[1.9rem] leading-none sm:text-5xl">{d.green.title}</h3>
          <ul class="mt-5 space-y-2.5 text-[0.95rem] sm:text-base">
            {
              d.green.items.map((item) => (
                <li class="flex gap-2.5">
                  <Mark class="mt-1 h-3 w-3 shrink-0" />
                  <span class="leading-snug">{item}</span>
                </li>
              ))
            }
          </ul>
          <p class="label mt-auto text-paper">{d.green.foot}</p>
        </div>
      </div>
      <div class="duo-red absolute inset-0 bg-duo-red text-paper">
        <div class="flex h-full w-1/2 flex-col p-4 sm:p-9">
          <p class="label text-paper">{d.red.note}</p>
          <h3 class="mt-2 text-[1.9rem] leading-none sm:text-5xl">{d.red.title}</h3>
          <ul class="mt-5 space-y-2.5 text-[0.95rem] sm:text-base">
            {
              d.red.items.map((item) => (
                <li class="flex gap-2.5">
                  <Mark class="mt-1 h-3 w-3 shrink-0" />
                  <span class="leading-snug">{item}</span>
                </li>
              ))
            }
          </ul>
          <p class="label mt-auto text-paper">{d.red.foot}</p>
        </div>
      </div>
      <div class="duo-handle pointer-events-none absolute inset-y-0 w-0.5 bg-paper" aria-hidden="true">
        <span class="duo-knob absolute top-1/2 left-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-ink bg-paper text-ink">
          <Mark class="h-5 w-5" />
        </span>
      </div>
      <input
        type="range"
        min="15"
        max="85"
        value="50"
        aria-label={d.sliderLabel}
        hidden
        data-duo-range
        class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
      />
    </div>
    <p class="label mt-3 text-muted" data-duo-hint hidden>{d.hint}</p>

    <table class="duo-table mt-16 w-full text-left">
      <caption class="label mb-5 text-left text-muted">{d.tableCaption}</caption>
      <thead>
        <tr class="label text-muted">
          <th scope="col" class="pb-3 font-normal">{d.columns.topic}</th>
          <th scope="col" class="pb-3 font-normal text-duo-red">{d.columns.agency}</th>
          <th scope="col" class="pb-3 font-normal text-cobalt">{d.columns.me}</th>
        </tr>
      </thead>
      <tbody>
        {
          d.rows.map((r) => (
            <tr class="border-t border-ink/15">
              <th scope="row" class="py-6 pr-8 align-top font-display text-[1.7rem] leading-tight font-normal text-ink">
                {r.topic}
              </th>
              <td data-label={d.columns.agency} class="py-6 pr-8 align-top">
                <strong class="block font-semibold text-duo-red">{r.agencyShort}</strong>
                <span class="mt-1 block leading-relaxed text-ink-soft">{r.agency}</span>
              </td>
              <td data-label={d.columns.me} class="py-6 align-top">
                <strong class="block font-semibold text-cobalt">{r.meShort}</strong>
                <span class="mt-1 block leading-relaxed text-ink">{r.me}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .duo-red {
    clip-path: inset(0 calc(100% - var(--r)) 0 0);
  }
  .duo-handle {
    left: var(--r);
  }
  .duo:has(input:focus-visible) .duo-knob {
    outline: 3px solid var(--color-paper);
    outline-offset: 3px;
  }
  .duo-table th,
  .duo-table td {
    width: 33%;
  }

  /* Phones: each row becomes a stacked card; still a real table underneath. */
  @media (max-width: 767px) {
    .duo-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .duo-table tbody,
    .duo-table tr,
    .duo-table th,
    .duo-table td {
      display: block;
      width: auto;
    }
    .duo-table tr {
      padding: 1.25rem 0;
    }
    .duo-table th[scope="row"],
    .duo-table td {
      padding: 0 0 0.75rem;
    }
    .duo-table td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-muted);
      margin-bottom: 0.25rem;
    }
  }
</style>

<script>
  const duo = document.querySelector<HTMLElement>("[data-duo]");
  const range = duo?.querySelector<HTMLInputElement>("[data-duo-range]");
  if (duo && range) {
    range.hidden = false;
    document.querySelector<HTMLElement>("[data-duo-hint]")!.hidden = false;
    range.addEventListener("input", () => duo.style.setProperty("--r", `${range.value}%`));
  }
</script>
