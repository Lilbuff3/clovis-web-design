---
import Mark from "./Mark.astro";
import { formatSmsUri } from "@/data/calculator";
import { brand, footer } from "@/data/fovea";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-ink/12 bg-ink pb-24 text-bone md:pb-0">
  <div class="mx-auto max-w-[1500px] px-4 pt-16 sm:px-6 lg:px-10">
    <div class="grid grid-cols-1 gap-10 border-b border-bone/15 pb-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-full bg-butter text-ink">
            <Mark class="h-4 w-4" />
          </span>
          <span class="font-display text-[26px] leading-none">{brand.name}</span>
        </div>
        <p class="mt-6 max-w-[40ch] text-[15px] leading-relaxed text-bone/80">{footer.blurb}</p>
        <a
          href={formatSmsUri()}
          class="group mt-7 inline-flex min-h-[48px] items-center gap-3 rounded-full border border-bone/30 px-6 transition-colors hover:border-butter hover:text-butter"
        >
          <span class="label">{footer.cta}</span>
          <span class="transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>

      <nav class="md:col-span-3" aria-label="Footer">
        <h2 class="label font-mono text-bone/60">{footer.linksTitle}</h2>
        <ul class="mt-4">
          {
            footer.links.map((l) => (
              <li>
                <a href={`/#${l.id}`} class="inline-flex min-h-[48px] items-center text-[15px] text-bone/85 transition-colors hover:text-butter">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:col-span-4">
        <h2 class="label font-mono text-bone/60">{footer.receptionTitle}</h2>
        <ul class="mt-4 text-[15px] text-bone/85">
          <li>
            <a href="tel:+15595753014" class="inline-flex min-h-[48px] items-center transition-colors hover:text-butter">(559) 575-3014</a>
          </li>
          <li>
            <a href="mailto:adam@cloviswebdesign.com" class="inline-flex min-h-[48px] items-center transition-colors hover:text-butter">adam@cloviswebdesign.com</a>
          </li>
          <li class="mt-2 text-bone/70">{footer.based}</li>
          <li class="mt-2 text-bone/70">{footer.towns}</li>
        </ul>
      </div>
    </div>

    <!-- The wordmark, enormous. -->
    <div class="relative pt-8 pb-10" aria-hidden="true">
      <div class="w-full text-center font-display leading-[0.8] tracking-[-0.04em] text-bone" style="font-size:clamp(4rem,23vw,21rem)">
        {footer.wordmark}
      </div>
      <span class="label absolute inset-x-0 bottom-2 text-center text-bone/60">{footer.wordmarkNote}</span>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-bone/15 py-6">
      <span class="label text-bone/60">© {year} {brand.name}</span>
      <span class="label text-bone/60">{footer.legal}</span>
      <span class="tightnum text-[0.6875rem] text-bone/60">{footer.craft}</span>
    </div>

    <p class="tightnum pb-8 text-center text-[0.6875rem] text-bone/60">{footer.sign}</p>
  </div>
</footer>
