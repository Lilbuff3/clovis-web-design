---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { caseStudies } from "@/data/caseStudies";
import { BRIEF_MAILTO, formatSmsUri } from "@/data/calculator";
import { brand, footer, nav } from "@/data/fovea";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink pt-20 pb-28 text-paper md:pb-12">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-10">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3">
          <Mark class="h-8 w-8 text-paper" />
          <span class="font-display text-[1.6rem] leading-none">{brand.name}</span>
        </div>
        <p class="mt-5 max-w-[40ch] leading-relaxed text-paper/80">{footer.blurb}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={formatSmsUri()}
            class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-paper px-5 text-[0.9rem] font-semibold text-ink transition-colors hover:bg-cobalt hover:text-paper"
          >
            <Icon name="message" class="h-4 w-4" />
            Text Adam
          </a>
          <a
            href={BRIEF_MAILTO}
            class="inline-flex min-h-[48px] items-center rounded-full border border-paper/30 px-5 text-[0.9rem] font-semibold transition-colors hover:border-paper"
          >
            {footer.cta}
          </a>
        </div>
      </div>

      <nav class="lg:col-span-3" aria-label="Footer">
        <h2 class="label text-paper/60">On this page</h2>
        <ul class="mt-4">
          {
            nav.map((l) => (
              <li>
                <a href={`/#${l.id}`} class="inline-flex min-h-[48px] min-w-[48px] items-center text-paper/85 transition-colors hover:text-paper">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <h2 class="label text-paper/60">Reception</h2>
        <ul class="mt-4">
          <li>
            <a href="tel:+15595753014" class="inline-flex min-h-[48px] items-center gap-2 font-semibold hover:text-paper/80">
              <Icon name="phone" class="h-4 w-4" />
              (559) 575-3014
            </a>
          </li>
          <li>
            <a href="mailto:adam@cloviswebdesign.com" class="inline-flex min-h-[48px] items-center underline decoration-paper/40 underline-offset-4 hover:decoration-paper">
              adam@cloviswebdesign.com
            </a>
          </li>
        </ul>
        <p class="mt-2 text-sm text-paper/70">{footer.based}</p>
        <h2 class="label mt-8 text-paper/60">Prescriptions on file</h2>
        <ul class="mt-2">
          {
            caseStudies.map((s) => (
              <li>
                <a href={`/work/${s.id}/`} class="group flex min-h-[48px] flex-col justify-center">
                  <span class="font-semibold group-hover:underline">{s.client} ↗</span>
                  <span class="text-sm text-paper/65">{s.location}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-16 overflow-hidden border-t border-paper/15 pt-6" aria-hidden="true">
      <span class="block font-display text-[clamp(3.4rem,15.5vw,15rem)] leading-[0.85] whitespace-nowrap text-paper/10">
        Clovis Web Design
      </span>
    </div>

    <div class="mt-6 flex flex-col gap-4 border-t border-paper/15 pt-6 text-sm text-paper/65 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {brand.name}. Built by hand by Adam Youssef in Clovis, California. {footer.towns}</p>
      <a href="#top" class="inline-flex min-h-[48px] w-fit items-center gap-2 rounded-full border border-paper/25 px-4 hover:border-paper">
        Back to top ↑ <span class="label">{footer.sign}</span>
      </a>
    </div>
  </div>
</footer>
