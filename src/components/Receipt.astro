---
import { caseStudies } from "@/data/caseStudies";

const sites = caseStudies.map((s) => ({
  client: s.client,
  host: new URL(s.url).hostname.replace(/^www\./, ""),
  psi: `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(s.url)}&form_factor=mobile`,
}));

const targets = [
  { value: "< 1.0s", label: "Largest Contentful Paint", note: "Google calls under 2.5s good" },
  { value: "0.0", label: "Cumulative Layout Shift", note: "Nothing jumps around while it loads" },
  { value: "< 50ms", label: "Interaction to Next Paint", note: "Buttons answer the moment you tap" },
];
---

<section id="receipt" class="scroll-mt-24 border-t border-ink/10 bg-paper-deep/30 py-24 sm:py-32" aria-labelledby="receipt-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-reveal>
    <div class="mx-auto max-w-3xl text-center">
      <span class="t-eyebrow text-stone">The Receipt</span>
      <h2 id="receipt-title" class="t-h2 mt-3 text-ink">
        Don&rsquo;t take my word for it. <br />
        <span class="italic text-clay">Test the sites yourself.</span>
      </h2>
      <p class="mt-4 text-base text-ink-soft sm:text-lg leading-relaxed">
        Both sites score 100 on Google PageSpeed, on mobile and on desktop. Any agency can put that on a slide, so these
        links run Google&rsquo;s own test on the live sites right now &mdash; you see whatever it finds today, not a
        screenshot I picked.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-2">
      {
        sites.map((s) => (
          <a
            href={s.psi}
            target="_blank"
            rel="noopener"
            class="paper-card group flex flex-col rounded-3xl border border-ink/10 p-7 transition-all duration-300 hover:border-clay/50 hover:shadow-md"
          >
            <span class="font-mono text-xs uppercase tracking-widest text-stone">{s.client}</span>
            <span class="mt-2 font-serif text-2xl font-bold text-ink group-hover:text-clay">Test {s.host} ↗</span>
            <span class="mt-1 text-xs text-ink-soft">Opens Google PageSpeed Insights, mobile</span>
          </a>
        ))
      }
    </div>

    <div class="mt-12 rounded-3xl border border-ink/10 bg-paper p-8 shadow-sm sm:p-10">
      <p class="text-center font-mono text-xs uppercase tracking-widest text-stone">What I build to</p>
      <dl class="mt-6 grid grid-cols-1 gap-8 md:grid-cols-3 md:divide-x md:divide-ink/10">
        {
          targets.map((t) => (
            <div class="flex flex-col items-center text-center md:px-4">
              <dt class="order-2 mt-1 text-xs font-semibold uppercase tracking-wider text-ink">{t.label}</dt>
              <dd class="order-1 font-mono text-3xl font-bold text-olive">{t.value}</dd>
              <dd class="order-3 mt-1 text-xs text-stone">{t.note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
