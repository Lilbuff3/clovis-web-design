---
import Mark from "./Mark.astro";
import SectionHead from "./SectionHead.astro";
import { lensTray as t } from "@/data/fovea";

// Tab state is plain radios; these rules show the checked lens's panel. Generated so adding a lens needs no CSS edits.
const css = t.lenses
  .map(
    (_, i) =>
      `.tray:has(#lens-${i}:checked) [data-panel="${i}"]{display:grid}` +
      `.tray:has(#lens-${i}:checked) label[for="lens-${i}"] .lens-face{border-color:var(--color-cobalt);background:var(--color-cobalt-wash);color:var(--color-cobalt)}` +
      `.tray:has(#lens-${i}:focus-visible) label[for="lens-${i}"]{outline:2px solid var(--color-cobalt);outline-offset:4px;border-radius:999px}`
  )
  .join("");
---

<section id="receipt" class="scroll-mt-28 border-t border-ink/10 bg-panel py-24 sm:py-32" aria-labelledby="receipt-title">
  <style is:inline set:html={css}></style>
  <div class="tray mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-10">
    <SectionHead id="receipt-title" {...t.head} />

    <fieldset class="mt-12">
      <legend class="sr-only">{t.head.label}</legend>
      <div class="flex flex-wrap gap-3 sm:gap-6">
        {
          t.lenses.map((lens, i) => (
            <>
              <input type="radio" name="lens" id={`lens-${i}`} class="sr-only" checked={i === 0} />
              <label for={`lens-${i}`} class="group flex min-h-[48px] cursor-pointer items-center gap-3">
                <span class="lens-face optotype flex h-14 w-14 items-center justify-center rounded-full border-2 border-ink/25 bg-card text-base text-ink transition-colors group-hover:border-ink sm:h-16 sm:w-16">
                  0{i + 1}
                </span>
                <span class="text-[1.05rem] font-semibold text-ink">{lens.name}</span>
              </label>
            </>
          ))
        }
      </div>
    </fieldset>

    {
      t.lenses.map((lens, i) => (
        <div data-panel={i} class="lens-panel mt-10 gap-8 lg:grid-cols-12 lg:gap-12">
          <figure class="lg:col-span-7">
            <div class="light-table rounded-[28px] border border-ink/15 p-5 sm:p-10">
              <div aria-hidden="true" class="mx-auto max-w-md">
                {lens.kind === "bigbros" && (
                  <div class="rounded-2xl bg-[#f7f5ee] p-5 text-[#1f2a22] shadow-[0_30px_60px_-35px_rgba(22,35,44,0.6)] sm:p-6">
                    <p class="font-display text-[1.7rem] leading-none">Pricing, published.</p>
                    <p class="mt-1.5 text-sm opacity-80">One flat price. No per-item surcharges, ever.</p>
                    {[
                      ["14-yard", "Cleanouts · small remodels", "$399"],
                      ["20-yard", "Renovations · big volume", "$499"],
                    ].map(([size, use, price]) => (
                      <div class="mt-4 flex items-end justify-between border-t border-[#1f2a22]/15 pt-3">
                        <span>
                          <span class="block font-semibold">{size}</span>
                          <span class="text-sm opacity-75">{use}</span>
                        </span>
                        <span class="text-2xl font-semibold">
                          {price} <span class="font-mono text-xs opacity-70">flat</span>
                        </span>
                      </div>
                    ))}
                    <ul class="mt-4 space-y-1 border-t border-[#1f2a22]/15 pt-3 text-sm">
                      <li>✓ 7-day rental, delivery &amp; pickup</li>
                      <li>✓ Mattresses, appliances, furniture included</li>
                      <li>✓ Boards under the wheels, driveway protected</li>
                    </ul>
                    <span class="mt-5 inline-block rounded-lg bg-[#95562c] px-4 py-2.5 text-sm font-semibold text-white">Text us for a quote</span>
                  </div>
                )}
                {lens.kind === "kidney" && (
                  <div class="overflow-hidden rounded-2xl bg-[#faf3e8] text-[#2c2620] shadow-[0_30px_60px_-35px_rgba(22,35,44,0.6)]">
                    <p class="bg-[#3e6153] px-4 py-2.5 text-center text-[0.8rem] leading-snug text-white">
                      Not sure if you need a kidney specialist? Call and ask, (559) 661-1965 · <span class="text-[#f3c98b]">Se habla español</span>
                    </p>
                    <div class="flex items-center justify-between gap-3 px-4 py-3">
                      <span class="flex items-center gap-2">
                        <span class="h-7 w-7 rounded-full bg-[#a35530]" />
                        <span class="font-display text-lg leading-none">Kidney Specialist Inc.</span>
                      </span>
                      <span class="rounded-full bg-[#a35530] px-3 py-1.5 text-xs font-semibold text-white">Call</span>
                    </div>
                    <p class="px-4 pt-3 pb-6 font-display text-[2rem] leading-none">Expert Kidney Care for the Central Valley</p>
                  </div>
                )}
                {lens.kind === "sample" && (
                  <div class="rounded-2xl border border-ink/10 bg-white p-5 text-ink shadow-[0_30px_60px_-35px_rgba(22,35,44,0.6)] sm:p-6">
                    <p class="font-mono text-[0.7rem] tracking-[0.14em] text-ink/60 uppercase">Roofing · Fresno &amp; Clovis</p>
                    <p class="mt-2 font-display text-[2.1rem] leading-none">Leak today? Text a photo of the roof.</p>
                    <p class="mt-2 text-sm text-ink/70">Free estimates. Reply by text.</p>
                    <span class="mt-5 flex gap-2">
                      <span class="rounded-full bg-ink px-4 py-2.5 text-sm font-semibold text-white">Text a photo</span>
                      <span class="rounded-full border border-ink/30 px-4 py-2.5 text-sm font-semibold">Call</span>
                    </span>
                  </div>
                )}
              </div>
            </div>
            <figcaption class="label mt-3 text-muted">{lens.source}</figcaption>
          </figure>

          <ol class="space-y-6 lg:col-span-5 lg:pt-4">
            {lens.notes.map(([title, detail], n) => (
              <li class="flex gap-4">
                <span class="optotype flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink text-sm text-paper">{n + 1}</span>
                <span>
                  <span class="block font-display text-2xl leading-tight text-ink">{title}</span>
                  <span class="mt-1 block leading-relaxed text-ink-soft">{detail}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }

    <p class="label mt-20 flex items-center gap-2 border-t border-ink/15 pt-12 text-muted"><Mark class="h-3 w-3" /> {t.targetsTitle}</p>
    <dl class="mt-3 grid gap-6 rounded-[28px] border border-ink/15 bg-card p-6 sm:grid-cols-3 sm:p-9">
      {
        t.targets.map((x) => (
          <div class="flex flex-col">
            <dt class="label order-2 mt-2 text-ink">{x.label}</dt>
            <dd class="optotype order-1 text-4xl text-cobalt">{x.value}</dd>
            <dd class="order-3 mt-1 text-sm text-muted">{x.note}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .lens-panel {
    display: none;
  }
  .light-table {
    background-color: var(--color-card);
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-ink) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-ink) 6%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
  }
</style>
