---
import Mark from "./Mark.astro";
import { formatSmsUri } from "@/data/calculator";
import { brand, chrome, nav } from "@/data/fovea";
---

<!-- The original's pill nav: sits clear over the page, turns solid once you scroll (CSS scroll timeline; solid without it). -->
<header class="nav fixed inset-x-0 top-8 z-50">
  <div class="mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-10">
    <div class="nav-pill flex items-center justify-between rounded-full border px-3 py-2">
      <a href="/" class="group flex min-h-[48px] items-center gap-3 pl-1" aria-label={`${brand.name}, home`}>
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-bone transition-transform duration-500 group-hover:-rotate-90">
          <Mark class="h-4 w-4" />
        </span>
        <span class="flex flex-col leading-none">
          <span class="font-display text-[18px] leading-none font-medium tracking-[-0.03em] sm:text-[22px]">{brand.name}</span>
          <span class="label mt-1 text-muted">{brand.tagline}</span>
        </span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
        {
          nav.map((item) => (
            <a href={`/#${item.id}`} class="group relative inline-flex min-h-[48px] items-center rounded-full px-4">
              <span class="label text-ink-2 transition-colors group-hover:text-ink">{item.label}</span>
              <span class="absolute inset-x-3 bottom-2 h-px origin-left scale-x-0 bg-vermilion transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true" />
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a href={formatSmsUri()} class="wipe hidden min-h-[48px] items-center rounded-full bg-ink px-5 text-bone sm:inline-flex" aria-label="Text Adam at (559) 575-3014">
          <span class="label relative z-10">{chrome.textMe}</span>
        </a>
        <button
          type="button"
          popovertarget="mobile-menu"
          aria-label="Menu"
          class="burger grid h-12 w-12 place-items-center rounded-full border border-ink/15 lg:hidden"
        >
          <span class="flex flex-col gap-[4px]" aria-hidden="true">
            <span class="block h-[1.5px] w-4 bg-ink transition-transform duration-300"></span>
            <span class="block h-[1.5px] w-4 bg-ink transition-opacity duration-300"></span>
            <span class="block h-[1.5px] w-4 bg-ink transition-transform duration-300"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  popover
  class="inset-x-4 top-[124px] bottom-auto m-0 w-auto rounded-3xl border border-ink/12 bg-bone/95 p-3 text-ink shadow-[0_30px_60px_-30px_rgba(22,35,44,0.6)] backdrop-blur-xl backdrop:bg-ink/20 sm:inset-x-6"
>
  <nav aria-label="Mobile">
    {
      nav.map((item) => (
        <a href={`/#${item.id}`} class="flex min-h-[56px] items-baseline justify-between border-b border-ink/8 py-3">
          <span class="font-display text-2xl">{item.label}</span>
          <span class="label text-muted">{item.id.slice(0, 4)}</span>
        </a>
      ))
    }
    <a href={formatSmsUri()} class="flex min-h-[56px] items-baseline justify-between py-3">
      <span class="font-display text-2xl text-vermilion">{chrome.textMe}</span>
      <span class="label text-muted">(559) 575-3014</span>
    </a>
  </nav>
</div>

<script>
  // Anchor links don't dismiss a popover on their own.
  const menu = document.getElementById("mobile-menu")!;
  menu.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) menu.hidePopover();
  });
</script>

<style>
  .nav {
    padding-block: 0.5rem;
  }
  .nav-pill {
    border-color: rgb(22 35 44 / 0.12);
    background: rgb(247 242 232 / 0.8);
    box-shadow: 0 10px 40px -24px rgb(22 35 44 / 0.5);
    backdrop-filter: blur(24px);
  }
  @supports (animation-timeline: scroll()) {
    @keyframes nav-top {
      from {
        padding-block: 1rem;
      }
    }
    @keyframes pill-top {
      from {
        border-color: transparent;
        background: transparent;
        box-shadow: none;
        backdrop-filter: blur(0);
        padding-block: 0.625rem;
      }
    }
    .nav,
    .nav-pill {
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 90px;
    }
    .nav {
      animation-name: nav-top;
    }
    .nav-pill {
      animation-name: pill-top;
    }
  }
  /* The burger becomes an X while the menu is open. */
  :global(body:has(#mobile-menu:popover-open)) .burger > span > span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  :global(body:has(#mobile-menu:popover-open)) .burger > span > span:nth-child(2) {
    opacity: 0;
  }
  :global(body:has(#mobile-menu:popover-open)) .burger > span > span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }
</style>
