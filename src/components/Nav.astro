---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { formatSmsUri, BRIEF_MAILTO } from "@/data/calculator";
import { brand, nav } from "@/data/fovea";
---

<header class="fixed inset-x-0 top-0 z-50">
  <!-- Reading-depth ruler: ticks, with a cobalt bar that fills as you scroll (CSS scroll timeline). -->
  <div class="ruler relative h-5 border-b border-ink/15 bg-paper/90 backdrop-blur" aria-hidden="true">
    <div class="ruler-fill absolute inset-y-0 left-0 w-full origin-left bg-cobalt/15"></div>
    <div class="label absolute inset-y-0 left-4 hidden items-center text-[0.625rem] text-muted sm:flex"><span class="bg-paper px-1.5">Reading depth</span></div>
    <div class="label absolute inset-y-0 right-4 hidden items-center text-[0.625rem] text-muted sm:flex"><span class="bg-paper px-1.5">Acuity 20/20</span></div>
  </div>

  <div class="mx-auto w-full max-w-[1440px] px-4 pt-2 sm:px-6 lg:px-10">
    <div class="flex items-center justify-between rounded-full border border-ink/12 bg-paper/90 py-1.5 pr-1.5 pl-4 shadow-[0_18px_40px_-30px_rgba(22,35,44,0.9)] backdrop-blur-xl sm:pl-5">
      <a href="/" class="group flex min-h-[48px] items-center gap-3" aria-label={`${brand.name}, home`}>
        <Mark class="h-7 w-7 text-ink transition-transform duration-500 group-hover:rotate-90" />
        <span class="flex flex-col leading-none">
          <span class="font-display text-[1.3rem] leading-none text-ink">{brand.name}</span>
          <span class="label mt-1 text-[0.625rem] text-muted">{brand.tagline}</span>
        </span>
      </a>

      <nav class="hidden items-center lg:flex" aria-label="Main">
        {
          nav.map((item) => (
            <a
              href={`/#${item.id}`}
              class="label inline-flex min-h-[48px] items-center rounded-full px-3.5 text-ink-soft transition-colors hover:text-cobalt"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="tel:+15595753014"
          class="hidden min-h-[48px] items-center gap-2 rounded-full px-3 text-[0.85rem] font-semibold text-ink transition-colors hover:text-cobalt xl:inline-flex"
        >
          <Icon name="phone" class="h-4 w-4 text-cobalt" />
          (559) 575-3014
        </a>
        <a
          href={formatSmsUri()}
          class="hidden min-h-[48px] items-center gap-2 rounded-full bg-ink px-5 text-[0.85rem] font-semibold text-paper transition-colors hover:bg-cobalt md:inline-flex"
          aria-label="Text Adam at (559) 575-3014"
        >
          <Icon name="message" class="h-4 w-4 shrink-0" />
          Text Adam
        </a>
        <button
          type="button"
          popovertarget="mobile-menu"
          aria-label="Menu"
          class="flex h-12 w-12 items-center justify-center rounded-full border border-ink/15 lg:hidden"
        >
          <span class="flex w-5 flex-col gap-2" aria-hidden="true">
            <span class="block h-0.5 w-full bg-ink"></span>
            <span class="block h-0.5 w-full bg-ink"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  popover
  class="inset-x-0 top-0 bottom-auto m-0 w-full max-w-none rounded-b-[28px] border-0 border-b border-ink/15 bg-paper px-5 pt-6 pb-7 text-ink shadow-2xl backdrop:bg-ink/40"
>
  <div class="flex items-center justify-between">
    <span class="flex items-center gap-3">
      <Mark class="h-7 w-7 text-ink" />
      <span class="font-display text-[1.3rem]">{brand.name}</span>
    </span>
    <button
      type="button"
      popovertarget="mobile-menu"
      popovertargetaction="hide"
      aria-label="Close menu"
      class="flex h-12 w-12 items-center justify-center rounded-full border border-ink/15"
    >
      <Icon name="x" class="h-4 w-4" />
    </button>
  </div>

  <nav class="mt-4 flex flex-col divide-y divide-ink/10" aria-label="Mobile">
    {
      nav.map((item, i) => (
        <a href={`/#${item.id}`} class="group flex min-h-[52px] items-center justify-between">
          <span class="font-display text-[1.7rem] text-ink group-hover:text-cobalt">{item.label}</span>
          <span class="label text-muted">0{i + 1}</span>
        </a>
      ))
    }
  </nav>

  <div class="mt-6 flex flex-col gap-3">
    <a
      href={formatSmsUri()}
      class="flex min-h-[52px] items-center justify-center gap-2 rounded-full bg-ink text-[0.95rem] font-semibold text-paper transition-colors hover:bg-cobalt"
    >
      <Icon name="message" class="h-4 w-4" />
      Text Adam
    </a>
    <div class="flex gap-2">
      <a
        href="tel:+15595753014"
        class="inline-flex min-h-[48px] flex-1 items-center justify-center rounded-full border border-ink/20 text-[0.85rem] font-semibold"
      >
        Call (559) 575-3014
      </a>
      <a
        href={BRIEF_MAILTO}
        class="inline-flex min-h-[48px] flex-1 items-center justify-center rounded-full border border-ink/20 text-[0.85rem] font-semibold"
      >
        Email details ↗
      </a>
    </div>
  </div>
</div>

<script>
  // Anchor links don't dismiss a popover on their own.
  const menu = document.getElementById("mobile-menu")!;
  menu.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) menu.hidePopover();
  });
</script>

<style>
  .ruler {
    background-image: repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-ink) 45%, transparent) 0 1px,
        transparent 1px 45px
      ),
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--color-ink) 22%, transparent) 0 1px, transparent 1px 9px);
    background-size:
      100% 9px,
      100% 5px;
    background-position:
      0 100%,
      0 100%;
    background-repeat: repeat-x;
  }
</style>
