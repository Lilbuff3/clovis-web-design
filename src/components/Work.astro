---
import SectionHead from "./SectionHead.astro";
import { caseStudies, srcsetFor } from "@/data/caseStudies";
import { work } from "@/data/fovea";
import type { Metric } from "@/types";

const fmt = (m: Metric) => `${m.prefix ?? ""}${m.value.toFixed(m.decimals ?? 0)}${m.suffix ?? ""}`;
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<section id="work" class="scroll-mt-28 py-24 sm:py-32" aria-labelledby="work-title">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-10">
    <SectionHead id="work-title" {...work.head} />

    <div class="mt-14 space-y-8">
      {
        caseStudies.map((s, i) => (
          <article class="record grid grid-cols-1 gap-8 rounded-[28px] border border-ink/15 bg-card p-4 sm:p-8 lg:grid-cols-12 lg:gap-12" data-reveal>
            <div class:list={["lg:sticky lg:top-28 lg:col-span-7 lg:self-start", i % 2 === 1 && "lg:order-2"]}>
              <div class="overflow-hidden rounded-2xl border border-ink/15 bg-panel">
                <div class="flex items-center justify-between gap-3 border-b border-ink/10 py-1 pr-1.5 pl-4">
                  <span class="label truncate text-muted">{host(s.url)}</span>
                  <label class="ba-toggle label inline-flex min-h-[44px] shrink-0 cursor-pointer items-center gap-2 rounded-full px-3 text-ink hover:text-cobalt">
                    <input type="checkbox" class="sr-only" />
                    <span class="lens-dot" aria-hidden="true" />
                    <span class="when-after">{work.showBefore}</span>
                    <span class="when-before">{work.showAfter}</span>
                  </label>
                </div>
                <div class="relative aspect-[16/9]">
                  <img
                    src={s.image}
                    srcset={srcsetFor(s.image)}
                    sizes="(min-width: 1024px) 55vw, 100vw"
                    alt={s.imageAlt}
                    width={s.imageWidth}
                    height={s.imageHeight}
                    loading="lazy"
                    decoding="async"
                    class="shot-after absolute inset-0 h-full w-full object-cover object-top"
                  />
                  <div class="shot-before absolute inset-0 p-[4%]" aria-hidden="true">
                    <div class="h-[8%] w-full rounded bg-[#c9c5bb]" />
                    <div class="mt-[3%] flex h-[42%] items-center justify-center rounded bg-[#d6d2c8]">
                      <span class="h-10 w-10 rounded-full border-4 border-[#b9b3a3] border-t-transparent" />
                    </div>
                    <div class="mt-[4%] h-[3%] w-3/4 rounded bg-[#d9d5cc]" />
                    <div class="mt-[2%] h-[3%] w-2/3 rounded bg-[#dedad2]" />
                    <div class="mt-[2%] h-[3%] w-1/2 rounded bg-[#dedad2]" />
                    <div class="absolute inset-x-[4%] bottom-[4%] h-[14%] rounded bg-[#bcb7ab]" />
                  </div>
                </div>
              </div>
              <p class="before-note label mt-3 text-muted">{work.beforeNote}</p>
            </div>

            <div class="flex flex-col lg:col-span-5">
              <p class="label text-muted">
                {work.record} № {s.index} · {s.location} · {s.year}
              </p>
              <h3 class="mt-3 text-[2.4rem] leading-none text-ink sm:text-5xl">{s.client}</h3>
              <p class="mt-3 text-lg leading-snug text-ink-soft">{s.headline}</p>

              <dl class="mt-6 grid grid-cols-2 gap-4 border-y border-ink/10 py-5">
                {[s.metrics[0], s.metrics[2]].map((m) => (
                  <div class="flex flex-col-reverse gap-2">
                    <dt class="label text-muted">{m.label}</dt>
                    <dd class="optotype text-[2.1rem] text-ink sm:text-4xl">{fmt(m)}</dd>
                  </div>
                ))}
              </dl>

              <p class="label mt-6 text-cobalt">{work.complaint}</p>
              <p class="mt-2 leading-relaxed text-ink-soft">{s.challenge.headline}</p>

              <p class="label mt-6 text-cobalt">{work.prescription}</p>
              <ol class="mt-2 space-y-2">
                {s.solution.moves.slice(0, 3).map((mv, n) => (
                  <li class="flex gap-3 text-ink-soft">
                    <span class="label pt-1 text-muted">0{n + 1}</span>
                    {mv.title}
                  </li>
                ))}
              </ol>

              <blockquote class="mt-7 border-l-2 border-cobalt pl-4">
                <p class="font-display text-xl leading-snug text-ink italic">“{s.quote.text}”</p>
                <footer class="label mt-3 text-muted">{s.quote.name}</footer>
              </blockquote>

              <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-7">
                <a
                  href={`/work/${s.id}/`}
                  class="inline-flex min-h-[48px] items-center rounded-full bg-ink px-6 text-[0.9rem] font-semibold text-paper transition-colors hover:bg-cobalt"
                >
                  {work.read} →
                </a>
                <a href={s.url} target="_blank" rel="noopener" class="inline-flex min-h-[48px] items-center text-[0.9rem] font-semibold text-ink underline underline-offset-4 hover:text-cobalt">
                  {work.visit}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Before/after without script: a checkbox inside the label, read with :has(). */
  .shot-before,
  .before-note,
  .when-before {
    display: none;
  }
  .record:has(.ba-toggle input:checked) .shot-after,
  .record:has(.ba-toggle input:checked) .when-after {
    display: none;
  }
  .record:has(.ba-toggle input:checked) .shot-before,
  .record:has(.ba-toggle input:checked) .before-note {
    display: block;
  }
  .record:has(.ba-toggle input:checked) .when-before {
    display: inline;
  }
  .shot-before {
    background: #e7e2d5;
    filter: blur(1.6px) grayscale(1) contrast(0.8);
  }
  .ba-toggle:has(input:focus-visible) {
    outline: 2px solid var(--color-cobalt);
    outline-offset: 2px;
  }
  .lens-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-cobalt);
  }
  .record:has(.ba-toggle input:checked) .lens-dot {
    background: var(--color-muted);
  }
</style>
