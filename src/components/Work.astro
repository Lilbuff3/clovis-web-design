---
import { caseStudies } from "@/data/caseStudies";

const kidneyStudy = caseStudies.find((s) => s.id === "kidney-specialist-inc") || caseStudies[0];
const dumpsterStudy = caseStudies.find((s) => s.id === "big-bros-dumpster") || caseStudies[1];
---

<section id="work" class="scroll-mt-24 border-t border-ink/10 py-24 sm:py-32" aria-labelledby="work-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-reveal>
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="t-eyebrow text-stone">Selected Flagships</span>
        <h2 id="work-title" class="t-h2 mt-3 text-ink">
          Built for the Central Valley. <br />
          <span class="italic text-clay">Proven in production.</span>
        </h2>
      </div>
      <p class="max-w-md text-sm text-ink-soft leading-relaxed">
        Two real businesses, both live. Open either site and check the speed yourself.
      </p>
    </div>

    <div class="mt-16 space-y-12 sm:space-y-16">
      {/* Feature 1: Kidney Specialist Inc. (Asymmetric 7/5 Grid with Pure-CSS Browser Frame) */}
      <article
        class="paper-card group relative overflow-hidden rounded-3xl border border-ink/15 bg-linen/90 p-6 sm:p-8 lg:p-10 shadow-sm transition-all duration-500 hover:-translate-y-1 hover:border-clay/50 hover:shadow-2xl"
      >
        <div
          class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full opacity-25 blur-3xl transition-opacity group-hover:opacity-50"
          style={{ backgroundColor: kidneyStudy.accent }}
          aria-hidden="true"
        />

        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 pb-5">
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wider"
              style={{ backgroundColor: kidneyStudy.accentSoft, color: kidneyStudy.accent }}
            >
              {kidneyStudy.tag}
            </span>
            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-olive-deep/20 bg-olive/10 px-3 py-1 font-mono text-[11px] font-semibold text-olive-deep"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-olive animate-pulse" aria-hidden="true"></span>
              0 PHI FORMS &middot; 2026 HIPAA COMPLIANT
            </span>
          </div>
          <span class="font-mono text-xs text-stone">{kidneyStudy.location} &middot; {kidneyStudy.year}</span>
        </div>

        <div class="mt-8 grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
          {/* Pure-CSS Browser Mockup Frame (7 cols) */}
          <div class="lg:col-span-7">
            <div class="overflow-hidden rounded-2xl border border-ink/15 bg-paper-deep/50 shadow-xl transition-all duration-500 group-hover:shadow-2xl">
              <div class="flex items-center justify-between border-b border-ink/10 bg-paper-deep/80 px-4 py-3">
                <div class="flex items-center gap-1.5" aria-hidden="true">
                  <div class="h-3 w-3 rounded-full border border-black/10 bg-[#ff5f56]/90"></div>
                  <div class="h-3 w-3 rounded-full border border-black/10 bg-[#ffbd2e]/90"></div>
                  <div class="h-3 w-3 rounded-full border border-black/10 bg-[#27c93f]/90"></div>
                </div>
                <div class="mx-2 flex min-w-0 max-w-[220px] flex-1 items-center justify-center rounded-md border border-ink/10 bg-paper/90 px-3 py-1 font-mono text-xs text-ink-soft shadow-2xs sm:max-w-xs">
                  <span class="truncate">kidneyspecialistinc.com</span>
                </div>
                <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded bg-olive/15 px-2.5 py-1 font-mono text-[11px] font-bold text-olive-deep">
                  100 PSI
                </span>
              </div>
              <div class="relative aspect-16/9 overflow-hidden bg-paper-deep">
                <img
                  src={kidneyStudy.image}
                  alt={kidneyStudy.imageAlt}
                  width={kidneyStudy.imageWidth}
                  height={kidneyStudy.imageHeight}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                />
              </div>
            </div>
          </div>

          {/* Narrative & Proof Metrics (5 cols) */}
          <div class="flex flex-col justify-between lg:col-span-5">
            <div>
              <h3 class="font-serif text-2xl font-bold text-ink transition-colors duration-300 group-hover:text-clay sm:text-3xl">
                <a href={`/work/${kidneyStudy.id}/`} class="focus:outline-none">
                  {kidneyStudy.client}
                </a>
              </h3>
              <p class="mt-2 font-serif text-sm italic text-stone sm:text-base">{kidneyStudy.headline}</p>
              <p class="mt-4 text-sm leading-relaxed text-ink-soft">{kidneyStudy.summary}</p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                {
                  kidneyStudy.metrics.map((m) => (
                    <div class="rounded-2xl border border-ink/10 bg-paper-deep/40 p-3.5 text-left">
                      <span class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-3xl">
                        {m.prefix}
                        {m.value}
                        {m.suffix}
                      </span>
                      <span class="mt-1 block text-[11px] font-medium leading-tight text-stone">{m.label}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-ink/10 pt-5">
              <div class="flex flex-wrap gap-2">
                {
                  kidneyStudy.stack.map((tech) => (
                    <span class="rounded-md bg-paper-deep/70 px-2.5 py-1 font-mono text-[10px] text-stone">{tech}</span>
                  ))
                }
              </div>
              <a
                href={`/work/${kidneyStudy.id}/`}
                class="inline-flex min-h-[48px] items-center text-xs font-bold uppercase tracking-wider text-clay transition-transform duration-300 hover:translate-x-1"
              >
                Read the case study &rarr;
              </a>
            </div>
          </div>
        </div>
      </article>

      {/* Feature 2: Big Bros Dumpster Rentals (Inverted Asymmetric 5/7 Grid with Device Mockup) */}
      <article
        class="paper-card group relative overflow-hidden rounded-3xl border border-ink/15 bg-linen/90 p-6 sm:p-8 lg:p-10 shadow-sm transition-all duration-500 hover:-translate-y-1 hover:border-clay/50 hover:shadow-2xl"
      >
        <div
          class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full opacity-25 blur-3xl transition-opacity group-hover:opacity-50"
          style={{ backgroundColor: dumpsterStudy.accent }}
          aria-hidden="true"
        />

        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 pb-5">
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wider"
              style={{ backgroundColor: dumpsterStudy.accentSoft, color: dumpsterStudy.accent }}
            >
              {dumpsterStudy.tag}
            </span>
            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-clay/30 bg-clay/10 px-3 py-1 font-mono text-[11px] font-semibold text-clay"
            >
              <span aria-hidden="true">🏆</span> GOOGLE #1 SERP
            </span>
            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-ink/15 bg-paper px-3 py-1 font-mono text-[11px] font-bold text-ink"
            >
              $399 / $499 FLAT RATE
            </span>
            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-ink/10 bg-paper-deep/60 px-2.5 py-1 font-mono text-[11px] font-medium text-ink-soft"
            >
              <span aria-hidden="true">🇲🇽</span> Hablamos Espa&ntilde;ol
            </span>
          </div>
          <span class="font-mono text-xs text-stone">{dumpsterStudy.location} &middot; {dumpsterStudy.year}</span>
        </div>

        <div class="mt-8 grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
          {/* Narrative & Proof Metrics (5 cols on left for desktop) */}
          <div class="order-2 flex flex-col justify-between lg:order-1 lg:col-span-5">
            <div>
              <h3 class="font-serif text-2xl font-bold text-ink transition-colors duration-300 group-hover:text-clay sm:text-3xl">
                <a href={`/work/${dumpsterStudy.id}/`} class="focus:outline-none">
                  {dumpsterStudy.client}
                </a>
              </h3>
              <p class="mt-2 font-serif text-sm italic text-stone sm:text-base">{dumpsterStudy.headline}</p>
              <p class="mt-4 text-sm leading-relaxed text-ink-soft">{dumpsterStudy.summary}</p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                {
                  dumpsterStudy.metrics.map((m) => (
                    <div class="rounded-2xl border border-ink/10 bg-paper-deep/40 p-3.5 text-left">
                      <span class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-3xl">
                        {m.prefix}
                        {m.value}
                        {m.suffix}
                      </span>
                      <span class="mt-1 block text-[11px] font-medium leading-tight text-stone">{m.label}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-ink/10 pt-5">
              <div class="flex flex-wrap gap-2">
                {
                  dumpsterStudy.stack.map((tech) => (
                    <span class="rounded-md bg-paper-deep/70 px-2.5 py-1 font-mono text-[10px] text-stone">{tech}</span>
                  ))
                }
              </div>
              <a
                href={`/work/${dumpsterStudy.id}/`}
                class="inline-flex min-h-[48px] items-center text-xs font-bold uppercase tracking-wider text-clay transition-transform duration-300 hover:translate-x-1"
              >
                Read the case study &rarr;
              </a>
            </div>
          </div>

          {/* Device Showcase (7 cols on right for desktop) */}
          <div class="order-1 lg:order-2 lg:col-span-7">
            <div class="overflow-hidden rounded-2xl border border-ink/15 bg-paper-deep/50 shadow-xl transition-all duration-500 group-hover:shadow-2xl">
              <div class="flex items-center justify-between border-b border-ink/10 bg-paper-deep/80 px-4 py-3">
                <div class="flex items-center gap-1.5" aria-hidden="true">
                  <div class="h-3 w-3 rounded-full border border-black/10 bg-[#ff5f56]/90"></div>
                  <div class="h-3 w-3 rounded-full border border-black/10 bg-[#ffbd2e]/90"></div>
                  <div class="h-3 w-3 rounded-full border border-black/10 bg-[#27c93f]/90"></div>
                </div>
                <div class="mx-2 flex min-w-0 max-w-[220px] flex-1 items-center justify-center rounded-md border border-ink/10 bg-paper/90 px-3 py-1 font-mono text-xs text-ink-soft shadow-2xs sm:max-w-xs">
                  <span class="truncate">bigbrosdumpster.com</span>
                </div>
                <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded border border-clay/20 bg-clay/10 px-2.5 py-1 font-mono text-[11px] font-bold text-clay">
                  🇲🇽 Hablamos Espa&ntilde;ol
                </span>
              </div>
              <div class="relative aspect-16/9 overflow-hidden bg-paper-deep">
                <img
                  src={dumpsterStudy.image}
                  alt={dumpsterStudy.imageAlt}
                  width={dumpsterStudy.imageWidth}
                  height={dumpsterStudy.imageHeight}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                />
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2 border-t border-ink/10 bg-linen/95 px-4 py-2.5 text-xs">
                <span class="font-mono text-stone">Driveway Protection Guaranteed &middot; Boards under wheels</span>
                <span class="font-mono font-bold text-clay">Text-to-Book: (559) 495-8034</span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
