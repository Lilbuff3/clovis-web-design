---
import Icon from "./Icon.astro";
import SpeedCost from "./SpeedCost.astro";
import { SCOPE_TIERS, RETAINER_TIERS, LAUNCH_PROMO, BRIEF_MAILTO, formatSmsUri } from "@/data/calculator";

const carePlan = RETAINER_TIERS.find((r) => r.id === "care")!;
---

<section id="pricing" class="scroll-mt-24 border-t border-ink/10 py-24 sm:py-32" aria-labelledby="pricing-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-reveal>
    <div class="text-center">
      <span class="t-eyebrow text-stone">Pricing</span>
      <h2 id="pricing-title" class="t-h2 mt-3 text-ink">
        One price up front. <span class="italic text-clay">No monthly required.</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-ink-soft sm:text-lg leading-relaxed">
        You own the site the day it goes live &mdash; the code, the domain, all of it. Nothing here holds your website
        hostage.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        SCOPE_TIERS.map((tier) => {
          const isFeatured = tier.price !== null;
          return (
            <div
              class:list={[
                "relative flex flex-col rounded-3xl border p-7 transition-all duration-300",
                isFeatured
                  ? "border-clay bg-linen shadow-lg ring-1 ring-clay/40"
                  : "border-ink/10 bg-paper-deep/30 hover:border-ink/25",
              ]}
            >
              {isFeatured && LAUNCH_PROMO.active && (
                <span class="mb-4 inline-flex w-fit items-center gap-2 rounded-full bg-clay px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-linen">
                  Launch offer &middot; {LAUNCH_PROMO.blurb}
                </span>
              )}
              <h3 class="font-serif text-2xl font-bold text-ink">{tier.title}</h3>
              <p class="mt-2 text-sm text-ink-soft leading-relaxed">{tier.subtitle}</p>

              <div class="mt-6 flex items-baseline gap-3 border-t border-ink/10 pt-5">
                {tier.price !== null ? (
                  <>
                    <span class="font-serif text-4xl font-bold text-ink">${tier.price.toLocaleString()}</span>
                    {tier.regularPrice && (
                      <span class="font-serif text-lg text-stone line-through">
                        ${tier.regularPrice.toLocaleString()}
                      </span>
                    )}
                  </>
                ) : (
                  <span class="font-serif text-3xl font-bold text-ink">{tier.priceLabel}</span>
                )}
              </div>
              <span class="mt-1 block font-mono text-[11px] uppercase tracking-wider text-stone">{tier.timeline}</span>

              <ul class="mt-6 space-y-2.5">
                {tier.features.map((f) => (
                  <li class="flex gap-2.5 text-sm text-ink-soft">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-olive" />
                    <span class="leading-snug">{f}</span>
                  </li>
                ))}
              </ul>

              {tier.excludes && (
                <ul class="mt-4 space-y-2 border-t border-ink/10 pt-4">
                  {tier.excludes.map((f) => (
                    <li class="flex gap-2.5 text-sm text-stone">
                      <Icon name="x" class="mt-0.5 h-4 w-4 shrink-0 text-stone/70" />
                      <span class="leading-snug">{f}</span>
                    </li>
                  ))}
                </ul>
              )}

              <p class="mt-6 text-xs text-ink-soft leading-relaxed">{tier.bestFor}</p>

              <div class="mt-auto flex flex-wrap gap-2.5 pt-7">
                <a
                  href="tel:+15595753014"
                  class:list={[
                    "inline-flex min-h-[48px] w-full items-center justify-center sm:flex-1 gap-2 rounded-full px-5 py-3 text-sm font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-clay focus:ring-offset-2",
                    isFeatured ? "bg-ink text-linen hover:bg-clay" : "border border-ink/20 text-ink hover:border-ink",
                  ]}
                >
                  <Icon name="phone" class="h-4 w-4" />
                  <span>Call</span>
                </a>
                <a
                  href={formatSmsUri(tier.title)}
                  class="inline-flex min-h-[48px] w-full items-center justify-center sm:flex-1 gap-2 rounded-full border border-ink/20 px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-clay hover:text-clay focus:outline-none focus:ring-2 focus:ring-clay focus:ring-offset-2"
                >
                  <Icon name="message" class="h-4 w-4" />
                  <span>Text</span>
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="mt-8 rounded-3xl border border-ink/10 bg-paper-deep/40 p-7 sm:p-9">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
          <div class="flex flex-wrap items-baseline gap-3">
            <h3 class="font-serif text-xl font-bold text-ink">{carePlan.title}</h3>
            <span class="font-serif text-2xl font-bold text-ink">
              ${carePlan.monthlyPrice}<span class="text-sm font-normal text-stone">/mo</span>
            </span>
            <span class="rounded-full border border-olive-deep/40 bg-olive/10 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-olive-deep">
              Optional
            </span>
          </div>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">{carePlan.description}</p>
        </div>
        <ul class="grid gap-2 sm:min-w-[19rem]">
          {
            carePlan.features.map((f) => (
              <li class="flex gap-2.5 text-sm text-ink-soft">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-olive" />
                <span class="leading-snug">{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <SpeedCost />

    <p class="mt-8 text-center text-sm text-ink-soft">
      Not sure which one you need? Call or text me and I&rsquo;ll tell you straight &mdash; even if the answer is that you
      don&rsquo;t need me yet.{" "}
      <a
        href={BRIEF_MAILTO}
        class="rounded font-semibold text-clay underline underline-offset-4 hover:text-ink focus:outline-none focus:ring-2 focus:ring-clay"
        >Or send the details in writing.</a
      >
    </p>
  </div>
</section>
