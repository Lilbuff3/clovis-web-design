---
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";
import SpeedCost from "./SpeedCost.astro";
import { SCOPE_TIERS, RETAINER_TIERS, LAUNCH_PROMO, BRIEF_MAILTO, formatSmsUri } from "@/data/calculator";
import { fees } from "@/data/fovea";

const usd = (n: number) => `$${n.toLocaleString("en-US")}`;
---

<section id="pricing" class="scroll-mt-28 border-t border-ink/10 bg-panel py-24 sm:py-32" aria-labelledby="pricing-title">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-10">
    <SectionHead id="pricing-title" {...fees.head} />

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {
        SCOPE_TIERS.map((tier) => {
          const d = fees.tiers[tier.id];
          const featured = tier.id === fees.featured;
          return (
            <article
              class:list={[
                "flex flex-col rounded-[28px] border p-6 sm:p-8",
                featured ? "border-ink bg-butter shadow-[0_40px_70px_-45px_rgba(22,35,44,0.8)] lg:-translate-y-3" : "border-ink/15 bg-card",
              ]}
            >
              <div class="flex items-center gap-4">
                <span class="optotype flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-ink text-lg text-ink">
                  {d.code}
                </span>
                <div>
                  <h3 class="text-[2rem] leading-none text-ink">{d.name}</h3>
                  <p class="label mt-1.5 text-ink-soft">{tier.title} · {tier.timeline}</p>
                </div>
              </div>

              <p class="mt-5 leading-relaxed text-ink-soft">{tier.subtitle}</p>

              <div class="mt-6 border-t border-ink/15 pt-5">
                <div class="flex items-baseline gap-3">
                  <span class="optotype text-5xl text-ink">{tier.price !== null ? usd(tier.price) : tier.priceLabel}</span>
                  {tier.regularPrice && <s class="text-xl text-ink-soft">{usd(tier.regularPrice)}</s>}
                </div>
                {tier.regularPrice && LAUNCH_PROMO.active && (
                  <p class="label mt-2 text-ink">
                    {fees.launchNote} · {LAUNCH_PROMO.blurb}
                  </p>
                )}
              </div>

              <ul class="mt-6 space-y-2.5">
                {tier.features.map((f) => (
                  <li class="flex gap-2.5 text-ink">
                    <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-cobalt" />
                    <span class="leading-snug">{f}</span>
                  </li>
                ))}
              </ul>
              {tier.excludes && (
                <ul class="mt-4 space-y-2 border-t border-ink/15 pt-4">
                  {tier.excludes.map((f) => (
                    <li class="flex gap-2.5 text-ink-soft">
                      <Icon name="x" class="mt-1 h-4 w-4 shrink-0" />
                      <span class="leading-snug">{f}</span>
                    </li>
                  ))}
                </ul>
              )}

              <p class="mt-6 text-sm leading-relaxed text-ink-soft">
                <span class="label text-ink">{fees.bestFor}:</span> {tier.bestFor}
              </p>

              <div class="mt-auto flex gap-2.5 pt-7">
                <a
                  href={formatSmsUri(tier.title)}
                  class="inline-flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-full bg-ink px-5 text-[0.9rem] font-semibold text-paper transition-colors hover:bg-cobalt"
                >
                  <Icon name="message" class="h-4 w-4" />
                  {fees.text}
                </a>
                <a
                  href="tel:+15595753014"
                  class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full border border-ink/25 px-5 text-[0.9rem] font-semibold text-ink transition-colors hover:border-ink"
                >
                  <Icon name="phone" class="h-4 w-4" />
                  {fees.call}
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="mt-8 rounded-[28px] border border-ink/15 bg-card p-6 sm:p-9">
      <div class="grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h3 class="text-[2rem] leading-none text-ink">
            {fees.followUp.title}{" "}<em class="text-cobalt">{fees.followUp.accent}</em>
          </h3>
          <p class="mt-4 leading-relaxed text-ink-soft">{fees.followUp.lede}</p>
          <p class="mt-4 border-l-2 border-cobalt pl-4 leading-relaxed text-ink">{fees.followUp.promise}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3 lg:col-span-7">
          {
            RETAINER_TIERS.map((r) => (
              <div class="flex flex-col rounded-2xl border border-ink/12 p-5">
                <p class="label text-muted">{r.title}</p>
                <p class="optotype mt-2 text-3xl text-ink">
                  {usd(r.monthlyPrice)}
                  <span class="font-sans text-sm font-normal tracking-normal normal-case text-muted">/mo</span>
                </p>
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">{r.description}</p>
                <ul class="mt-4 space-y-2">
                  {r.features.map((f) => (
                    <li class="flex gap-2 text-sm text-ink">
                      <Icon name="check" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-cobalt" />
                      <span class="leading-snug">{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-8">
      <SpeedCost />
    </div>

    <p class="mt-8 text-center leading-relaxed text-ink-soft">
      {fees.unsure}
      <a href={BRIEF_MAILTO} class="ml-1 inline-flex min-h-[48px] items-center font-semibold text-cobalt underline underline-offset-4 hover:text-ink">
        {fees.brief}
      </a>
    </p>
  </div>
</section>
