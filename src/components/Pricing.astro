---
import Mark from "./Mark.astro";
import SectionHead from "./SectionHead.astro";
import Services from "./Services.astro";
import SpeedCost from "./SpeedCost.astro";
import { SCOPE_TIERS, RETAINER_TIERS, LAUNCH_PROMO, BRIEF_MAILTO, formatSmsUri } from "@/data/calculator";
import { fees } from "@/data/fovea";

const usd = (n: number) => `$${n.toLocaleString("en-US")}`;
---

<section id="pricing" class="paper relative scroll-mt-28 border-b border-ink/12" aria-labelledby="pricing-title">
  <div class="mx-auto max-w-[1500px] px-4 py-20 sm:px-6 md:py-28 lg:px-10">
    <SectionHead id="pricing-title" {...fees.head} />

    <!-- packages -->
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        SCOPE_TIERS.map((tier) => {
          const d = fees.tiers[tier.id];
          const featured = tier.id === fees.featured;
          return (
            <article
              class:list={[
                "relative flex flex-col rounded-[26px] border p-7 transition-colors duration-700 sm:p-8",
                featured ? "border-ink bg-butter shadow-[0_50px_90px_-60px_rgba(22,35,44,.9)] md:-mt-4 md:mb-4" : "border-ink/15 bg-bone hover:border-ink/35",
              ]}
              data-reveal
            >
              {featured && tier.regularPrice && LAUNCH_PROMO.active && (
                <span class="label absolute -top-3 left-7 rounded-full bg-vermilion px-3 py-1.5 text-bone">{fees.badge}</span>
              )}

              <div class="flex items-start justify-between">
                <span class:list={["tightnum text-[0.6875rem]", featured ? "text-ink-2" : "text-muted"]}>{d.code}</span>
                <Mark class={featured ? "h-4 w-4 text-ink/50" : "h-4 w-4 text-ink/15"} />
              </div>

              <h3 class="mt-5 text-[clamp(1.9rem,3.4vw,2.6rem)] text-ink">{d.name}</h3>
              <p class="label mt-2 text-ink-2">
                {tier.title} · {tier.timeline}
              </p>

              <div class="mt-7 flex flex-wrap items-end gap-x-2 gap-y-1">
                <span class="font-display text-[clamp(2.6rem,5.6vw,3.8rem)] leading-none text-ink">{tier.price !== null ? usd(tier.price) : tier.priceLabel}</span>
                {tier.regularPrice && <s class="mb-1.5 text-lg text-ink-2">{usd(tier.regularPrice)}</s>}
                <span class="label mb-2 text-ink-2">{fees.oneOff}</span>
              </div>
              {tier.regularPrice && LAUNCH_PROMO.active && (
                <p class="label mt-2 text-ink">
                  {fees.launchNote} · {LAUNCH_PROMO.blurb}
                </p>
              )}

              <ul class="mt-7 grid gap-2.5 border-t border-ink/15 pt-6">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-3 text-[14.5px] leading-snug text-ink">
                    <span class:list={["mt-[7px] h-[5px] w-[5px] shrink-0 rounded-full", featured ? "bg-ink" : "bg-vermilion"]} aria-hidden="true" />
                    {f}
                  </li>
                ))}
              </ul>
              {tier.excludes && (
                <ul class="mt-4 grid gap-2">
                  {tier.excludes.map((f) => (
                    <li class="flex items-start gap-3 text-[13.5px] leading-snug text-ink-2">
                      <span class="mt-[9px] h-px w-[7px] shrink-0 bg-ink-2" aria-hidden="true" />
                      {f}
                    </li>
                  ))}
                </ul>
              )}

              <p class="accent mt-6 font-display text-[15px] leading-relaxed text-ink-2">{tier.bestFor}</p>

              <div class="mt-auto pt-8">
                <a
                  href={formatSmsUri(tier.title)}
                  class:list={["wipe block rounded-full border py-3.5 text-center", featured ? "border-ink bg-ink text-bone" : "border-ink/25 text-ink hover:border-ink"]}
                >
                  <span class="btn-label relative z-10">{fees.text}</span>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <Services />

    <!-- loose lenses: the follow-up plans, priced like a menu -->
    <div class="mt-8 grid grid-cols-1 gap-10 rounded-[26px] border border-ink/15 bg-bone-2 p-7 sm:p-10 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-4">
        <p class="label flex items-center gap-3 text-muted">
          <span class="h-px w-5 bg-ink/25" aria-hidden="true"></span>
          {fees.followUp.label}
        </p>
        <h3 class="mt-4 text-[clamp(1.6rem,3vw,2.2rem)] text-ink">
          {fees.followUp.title}<br /><em class="accent">{fees.followUp.accent}</em>
        </h3>
        <p class="mt-4 max-w-[36ch] text-[14.5px] leading-relaxed text-ink-2">{fees.followUp.lede}</p>
      </div>
      <div class="lg:col-span-8">
        <ul>
          {
            RETAINER_TIERS.map((r) => (
              <li class="border-b border-dotted border-ink/25 py-3.5">
                <div class="flex items-baseline gap-3">
                  <span class="text-[15.5px] text-ink">{r.title}</span>
                  <span class="mb-1 grow border-b border-dotted border-ink/25" aria-hidden="true" />
                  <span class="shrink-0 font-display text-[15px] text-ink tabular-nums">
                    {usd(r.monthlyPrice)}
                    <span class="text-ink-2">/mo</span>
                  </span>
                </div>
                <p class="mt-1 max-w-[60ch] text-[13.5px] leading-snug text-ink-2">{r.description}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 border-l-2 border-vermilion pl-4 text-[14.5px] leading-relaxed text-ink">{fees.followUp.promise}</p>
      </div>
    </div>

    <div class="mt-8">
      <SpeedCost />
    </div>

    <p class="mt-8 text-center text-[15px] leading-relaxed text-ink-2">
      {fees.unsure}{" "}
      <a href={BRIEF_MAILTO} class="inline-flex min-h-[48px] items-center text-vermilion underline underline-offset-4 hover:text-ink">
        {fees.brief}
      </a>
    </p>
  </div>
</section>
