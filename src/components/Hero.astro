---
import Mark from "./Mark.astro";
import AmbientVideo from "./AmbientVideo.astro";
import GuideGlasses from "./GuideGlasses.astro";
import { hero, ticker } from "@/data/fovea";
import { PRICING_CONSTANTS, formatSmsUri } from "@/data/calculator";

const price = PRICING_CONSTANTS.tiers.landing.price;
// Row sizes in container units, so the chart fits its column at any width. Biggest row first, like a Snellen chart.
// Row 1 is sized from the width left after its acuity label, so an ~8-letter word never overflows a 320px phone.
const sizes = [
  "clamp(1.9rem,calc((100cqi - 4.5rem) * 0.155),10.2rem)",
  "clamp(1.8rem,11cqi,8.3rem)",
  "clamp(1.6rem,8.8cqi,6.3rem)",
  "clamp(1.3rem,6.6cqi,4.7rem)",
  "clamp(1.1rem,5cqi,3.4rem)",
  "clamp(0.8rem,2.5cqi,1.62rem)",
  "clamp(0.72rem,1.8cqi,1.08rem)",
  "clamp(0.6875rem,1.35cqi,0.85rem)",
];
---

<section id="hero" class="paper relative overflow-hidden pt-28 md:pt-32" aria-labelledby="hero-title">
  <Mark class="pointer-events-none absolute top-1/3 -right-24 h-[560px] w-[560px] text-ink/[0.045]" />

  <div class="relative mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-10">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-ink/12 pb-4">
      <span class="label flex items-center gap-2 text-vermilion">
        <span class="anim-blink inline-block h-1.5 w-1.5 rounded-full bg-vermilion" aria-hidden="true"></span>
        {hero.status}
      </span>
      <span class="label text-muted">{hero.line}</span>
      <span class="label hidden text-muted sm:block">{hero.area}</span>
      <span class="label ml-auto hidden text-muted lg:block">{hero.chartNo}</span>
    </div>

    <h1 id="hero-title" class="sr-only">{hero.h1}</h1>

    <div class="grid grid-cols-1 gap-10 pt-8 pb-4 lg:grid-cols-12 lg:gap-8">
      <!-- the chart -->
      <div class="lg:col-span-8">
        <div class="chart select-none" data-chart aria-hidden="true">
          <div class="chart-base">
            {
              hero.chart.map((row, i) => (
                <div
                  class:list={["flex items-end justify-between gap-4 border-b border-ink/[0.07] leading-[0.9]", i >= 5 ? "py-[0.5em]" : "py-[0.2em]"]}
                  style={`font-size:${sizes[i]}`}
                >
                  {row.link ? (
                    <a
                      href="#book"
                      tabindex="-1"
                      class="optotype min-w-0 leading-[1.6] text-ink underline decoration-vermilion decoration-2 underline-offset-[3px] [overflow-wrap:anywhere] hover:text-vermilion"
                    >
                      {row.text}
                    </a>
                  ) : (
                    <span class:list={["optotype min-w-0 [overflow-wrap:anywhere]", row.accent ? "text-vermilion" : "text-ink", i >= 5 && "leading-[1.15]"]}>{row.text}</span>
                  )}
                  <span class="tightnum shrink-0 pb-[0.2em] text-[0.6875rem] text-muted">{row.acuity}</span>
                </div>
              ))
            }
          </div>
          <GuideGlasses />
        </div>

        <div class="mt-9 border-t border-ink/12 pt-5">
          <a href="#exam" class="label inline-flex min-h-[48px] items-center text-muted underline decoration-ink/25 underline-offset-4 transition-colors hover:text-vermilion">
            {hero.examLink}
          </a>
        </div>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2 sm:text-xl">{hero.pitch}</p>
        <p class="label mt-4 text-ink">{hero.priceLine(price)}</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={formatSmsUri()} class="wipe inline-flex min-h-[52px] items-center justify-center rounded-full bg-ink px-7 text-bone">
            <span class="btn-label relative z-10">{hero.ctaText}</span>
          </a>
          <a
            href="#pricing"
            class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-ink/25 px-7 text-ink transition-colors hover:border-ink"
          >
            <span class="btn-label">{hero.ctaPrices} ↓</span>
          </a>
        </div>
        <p data-reading data-template={hero.reading} hidden class="label mt-5 text-muted"></p>
      </div>

      <!-- the street, seen from forty feet -->
      <div class="relative lg:col-span-4">
        <div class="relative mx-auto w-full max-w-[380px] lg:mr-0 lg:ml-auto">
          <div class="arch relative overflow-hidden rounded-t-full border border-ink/15 bg-bone-2">
            <AmbientVideo name="street-phone" class="h-[360px] w-full object-cover opacity-90 lg:h-[440px]" />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bone/75 via-transparent to-bone/25" aria-hidden="true"></div>
            <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-4" aria-hidden="true">
              <span class="label min-w-0 text-ink">{hero.figure.caption}</span>
              <span class="tightnum shrink-0 whitespace-nowrap text-[0.6875rem] text-ink">{hero.figure.meta}</span>
            </div>
          </div>

          <!-- rotating seal -->
          <div class="pointer-events-none absolute -top-6 -left-14 hidden h-[132px] w-[132px] place-items-center lg:grid" aria-hidden="true">
            <svg viewBox="0 0 132 132" class="anim-spin-slow h-full w-full">
              <path id="seal-path" d="M66,66 m-49,0 a49,49 0 1,1 98,0 a49,49 0 1,1 -98,0" fill="none"></path>
              <circle cx="66" cy="66" r="64" fill="none" stroke="#16232c" stroke-opacity=".18"></circle>
              <circle cx="66" cy="66" r="34" fill="none" stroke="#b93b21" stroke-opacity=".55" stroke-dasharray="2 3"></circle>
              <text fill="#16232c" fill-opacity=".75" style="font-family:var(--font-mono);font-size:10px;letter-spacing:2.4px;text-transform:uppercase">
                <!-- textLength = the circle's circumference, so any seal text wraps exactly once. -->
                <textPath href="#seal-path" textLength="307" lengthAdjust="spacing">{hero.seal}</textPath>
              </text>
            </svg>
            <span class="absolute grid h-11 w-11 place-items-center rounded-full bg-vermilion text-bone">
              <Mark class="h-4 w-4" />
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ticker -->
  <div class="relative mt-6 overflow-hidden border-y border-ink/12 bg-vermilion py-2.5 text-bone">
    <div class="anim-marquee flex w-max">
      {
        [0, 1].map((copy) => (
          <ul class="label flex shrink-0 items-center gap-8 pr-8" aria-hidden={copy === 1 ? "true" : undefined}>
            {ticker(price).map((item) => (
              <li class="flex items-center gap-8 whitespace-nowrap">
                {item}
                <Mark class="h-2.5 w-2.5 shrink-0" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* The glasses rest at (--lx, --ly) and are --gw wide there (see GuideGlasses). Declared here so cqi means the chart's
     own width. On phones they rest left of the acuity labels. */
  .chart {
    position: relative;
    container-type: inline-size;
    --gw: clamp(200px, 62cqi, 500px);
    --lx: 50%;
    --ly: 30%;
  }
  @media (min-width: 640px) {
    .chart {
      --lx: 62%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The page opens foggy and comes into focus as the glasses land. The pitch and buttons are never blurred. */
    .chart-base,
    .arch {
      animation: focus-pull 0.8s var(--ease-out-expo) 0.3s backwards;
    }
  }
  @keyframes focus-pull {
    from {
      filter: blur(7px);
      opacity: 0.7;
    }
  }
</style>

<script>
  // The real load time of this page on this device, read as eyesight. Hidden if slow or unknown.
  const reading = document.querySelector<HTMLElement>("[data-reading]");
  const type = PerformanceObserver.supportedEntryTypes?.includes("largest-contentful-paint") ? "largest-contentful-paint" : "paint";
  if (reading) {
    new PerformanceObserver((list) => {
      const entry = list.getEntries().at(-1);
      if (!entry) return;
      const s = entry.startTime / 1000;
      if (s > 2.5) return;
      const acuity = s < 1 ? "20/20" : s < 1.8 ? "20/25" : "20/40";
      reading.textContent = reading.dataset.template!.replace("{time}", `${s.toFixed(2)}s`).replace("{acuity}", acuity);
      reading.hidden = false;
    }).observe({ type, buffered: true });
  }
</script>
