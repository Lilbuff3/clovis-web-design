---
import Mark from "./Mark.astro";
import { hero, ticker } from "@/data/fovea";
import { caseStudies, srcsetFor } from "@/data/caseStudies";
import { PRICING_CONSTANTS, formatSmsUri } from "@/data/calculator";

const price = PRICING_CONSTANTS.tiers.landing.price;
const bigBros = caseStudies.find((s) => s.id === "big-bros-dumpster")!;
// Row sizes in container units, so the chart fits its column at any width. Biggest row first, like a Snellen chart.
// Row 1 is sized from the width left after its acuity label, so an ~8-letter word never overflows a 320px phone.
const sizes = [
  "clamp(1.9rem,calc((100cqi - 4.5rem) * 0.155),9.5rem)",
  "clamp(1.8rem,11cqi,8rem)",
  "clamp(1.6rem,8.8cqi,6.4rem)",
  "clamp(1.3rem,6.6cqi,4.8rem)",
  "clamp(1.1rem,5cqi,3.6rem)",
  "clamp(0.8rem,2.5cqi,1.5rem)",
  "clamp(0.72rem,1.8cqi,1.1rem)",
  "clamp(0.6875rem,1.35cqi,0.85rem)",
];
---

<section id="hero" class="relative pt-[104px] sm:pt-[124px]" aria-labelledby="hero-title">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-10">
    <div class="label flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-ink/15 pb-4 text-muted">
      <span class="inline-flex items-center gap-2 text-cobalt">
        <span class="status-dot h-2 w-2 rounded-full bg-cobalt" aria-hidden="true"></span>
        {hero.status}
      </span>
      <span class="flex items-center gap-4">
        <button
          type="button"
          data-lens-toggle
          data-on={`${hero.lensOn} · ${hero.lensHint}`}
          data-off={hero.lensOff}
          aria-pressed="true"
          hidden
          class="label -my-3 hidden min-h-[44px] items-center gap-3 sm:inline-flex rounded-full border border-ink/20 px-4 text-ink transition-colors hover:border-cobalt hover:text-cobalt"
        >
          <span class="lens-switch" aria-hidden="true"></span>
          <span data-lens-label>{hero.lensOn} · {hero.lensHint}</span>
        </button>
        {hero.eyebrow}
      </span>
    </div>

    <h1 id="hero-title" class="sr-only">{hero.h1}</h1>

    <div class="mt-8 grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <div class="chart" data-chart aria-hidden="true">
          {
            ["chart-base", "chart-sharp"].map((layer) => (
              <div class={layer}>
                {hero.chart.map((row, i) => (
                  <div
                    class:list={["flex items-end justify-between gap-4 border-b border-ink/10 leading-[0.9]", i >= 5 ? "py-[0.5em]" : "py-[0.14em]"]}
                    style={`font-size:${sizes[i]}`}
                  >
                    <span class:list={["optotype min-w-0 [overflow-wrap:anywhere]", row.accent ? "text-cobalt" : "text-ink", i >= 5 && "leading-[1.15]"]}>{row.text}</span>
                    <span class="label shrink-0 pb-[0.2em] text-[0.6875rem] text-muted">{row.acuity}</span>
                  </div>
                ))}
              </div>
            ))
          }
          <span class="lens-ring" aria-hidden="true"></span>
        </div>

        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl">{hero.pitch}</p>
        <p class="label mt-4 text-ink">{hero.priceLine(price)}</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href={formatSmsUri()}
            class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-ink px-7 text-[0.95rem] font-semibold text-paper transition-colors hover:bg-cobalt"
          >
            {hero.ctaText}
          </a>
          <a
            href="#pricing"
            class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-ink/25 px-7 text-[0.95rem] font-semibold text-ink transition-colors hover:border-cobalt hover:text-cobalt"
          >
            {hero.ctaPrices} ↓
          </a>
        </div>
        <p data-reading data-template={hero.reading} hidden class="label mt-5 text-muted"></p>
      </div>

      <figure class="relative mx-auto w-full max-w-md lg:col-span-5 lg:mt-4 lg:max-w-none">
        <div class="aspect-[4/5] overflow-hidden rounded-t-full border border-ink/15 bg-panel">
          <img
            src={bigBros.image}
            srcset={srcsetFor(bigBros.image)}
            sizes="(min-width: 1024px) 40vw, (min-width: 448px) 448px, 100vw"
            alt={hero.figure.alt}
            width={bigBros.imageWidth}
            height={bigBros.imageHeight}
            decoding="async"
            class="h-full w-full object-cover object-left-top"
          />
        </div>
        <figcaption class="mt-5 flex items-center gap-4">
          <span class="relative h-24 w-24 shrink-0 rounded-full border border-ink/15 bg-paper" aria-hidden="true">
            <svg viewBox="0 0 120 120" class="seal-text h-full w-full">
              <path id="seal-path" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" fill="none"></path>
              <text class="fill-ink" style="font-family:var(--font-mono);font-size:8.6px;letter-spacing:0.16em;text-transform:uppercase">
                <!-- textLength = the circle's circumference, so any seal text wraps exactly once. -->
                <textPath href="#seal-path" textLength="287" lengthAdjust="spacing">{hero.seal}</textPath>
              </text>
            </svg>
            <Mark class="absolute inset-0 m-auto h-8 w-8 text-cobalt" />
          </span>
          <span class="label text-muted">{hero.figure.caption}</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <div class="mt-16 overflow-hidden border-y border-ink bg-cobalt text-paper">
    <div class="ticker flex w-max">
      {
        [0, 1].map((copy) => (
          <ul class="label flex shrink-0 items-center gap-8 py-3.5 pr-8 text-[0.75rem]" aria-hidden={copy === 1 ? "true" : undefined}>
            {ticker(price).map((item) => (
              <li class="flex items-center gap-8 whitespace-nowrap">
                {item}
                <Mark class="h-3 w-3 text-paper/70" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .chart {
    position: relative;
    container-type: inline-size;
  }
  .chart-sharp,
  .lens-ring {
    display: none;
  }

  /* Lens mode: only switched on by the script, on devices with a mouse. */
  .chart.lens-on {
    --lr: 130px;
    cursor: crosshair;
  }
  .chart.lens-on .chart-base {
    filter: blur(1.8px) saturate(0.85);
    opacity: 0.7;
  }
  .chart.lens-on .chart-sharp {
    display: block;
    position: absolute;
    inset: 0;
    clip-path: circle(var(--lr) at var(--lx, 50%) var(--ly, 58%));
  }
  .chart.lens-on .lens-ring {
    display: block;
    position: absolute;
    left: var(--lx, 50%);
    top: var(--ly, 58%);
    width: calc(var(--lr) * 2);
    height: calc(var(--lr) * 2);
    translate: -50% -50%;
    border-radius: 50%;
    border: 1.5px solid var(--color-cobalt);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-cobalt) 8%, transparent);
    pointer-events: none;
  }

  .lens-switch {
    width: 26px;
    height: 14px;
    border-radius: 99px;
    background: var(--color-cobalt);
    position: relative;
  }
  .lens-switch::after {
    content: "";
    position: absolute;
    top: 2px;
    right: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-paper);
    transition: right 0.2s;
  }
  [aria-pressed="false"] .lens-switch {
    background: var(--color-muted);
  }
  [aria-pressed="false"] .lens-switch::after {
    right: 14px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* One focus pull on load, on every device. `backwards` so lens mode's blur takes over when it ends. */
    .chart-base {
      animation: focus-pull 0.8s var(--ease-expo) backwards;
    }
    .seal-text {
      animation: spin 28s linear infinite;
    }
    .ticker {
      animation: ticker 38s linear infinite;
    }
    .status-dot {
      animation: blink 1.6s steps(2, jump-none) infinite;
    }
  }
  @keyframes focus-pull {
    from {
      filter: blur(6px);
      opacity: 0.5;
    }
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes ticker {
    to {
      translate: -50% 0;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
</style>

<script>
  // Lens follows the pointer, only where there is one. Phones and reduced-motion users keep the sharp chart.
  const chart = document.querySelector<HTMLElement>("[data-chart]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-lens-toggle]");
  if (chart && toggle && matchMedia("(hover: hover) and (pointer: fine) and (min-width: 640px) and (prefers-reduced-motion: no-preference)").matches) {
    chart.classList.add("lens-on");
    toggle.hidden = false;
    chart.addEventListener("pointermove", (e) => {
      const r = chart.getBoundingClientRect();
      chart.style.setProperty("--lx", `${e.clientX - r.left}px`);
      chart.style.setProperty("--ly", `${e.clientY - r.top}px`);
    });
    toggle.addEventListener("click", () => {
      const on = chart.classList.toggle("lens-on");
      toggle.setAttribute("aria-pressed", String(on));
      toggle.querySelector("[data-lens-label]")!.textContent = on ? toggle.dataset.on! : toggle.dataset.off!;
    });
  }

  // The real load time of this page on this device, read as eyesight. Hidden if slow or unknown.
  const reading = document.querySelector<HTMLElement>("[data-reading]");
  const type = PerformanceObserver.supportedEntryTypes?.includes("largest-contentful-paint") ? "largest-contentful-paint" : "paint";
  if (reading) {
    new PerformanceObserver((list) => {
      const entry = list.getEntries().at(-1);
      if (!entry) return;
      const s = entry.startTime / 1000;
      if (s > 2.5) return;
      const acuity = s < 1 ? "20/20" : s < 1.8 ? "20/25" : "20/40";
      reading.textContent = reading.dataset.template!.replace("{time}", `${s.toFixed(2)}s`).replace("{acuity}", acuity);
      reading.hidden = false;
    }).observe({ type, buffered: true });
  }
</script>
