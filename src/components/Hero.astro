---
import Icon from "./Icon.astro";
import { LAUNCH_PROMO, SCOPE_TIERS, BRIEF_MAILTO, formatSmsUri } from "@/data/calculator";

const landing = SCOPE_TIERS.find((t) => t.id === "landing")!;
const linkClass =
  "rounded text-ink-soft underline underline-offset-4 transition-colors hover:text-clay focus:outline-none focus:ring-2 focus:ring-clay";
---

<section
  id="hero"
  class="relative flex min-h-[92vh] flex-col items-center justify-center overflow-hidden px-4 pt-28 pb-16 text-center sm:px-6 sm:pt-32 lg:px-8"
  aria-label="Introduction"
>
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-60" aria-hidden="true">
    <div class="h-[650px] w-[650px] rounded-full bg-paper-deep/80 blur-3xl sm:h-[800px] sm:w-[800px]"></div>
  </div>

  <div class="mx-auto max-w-5xl">
    <div
      class="mb-7 inline-flex items-center gap-3 rounded-full border border-clay/40 bg-clay/10 px-4 py-1.5 text-xs font-medium uppercase tracking-widest text-ink shadow-xs backdrop-blur"
    >
      <span class="relative flex h-2.5 w-2.5 items-center justify-center">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-olive opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-olive"></span>
      </span>
      <span class="font-sans font-semibold">Launch offer &middot; {LAUNCH_PROMO.blurb}</span>
    </div>

    <h1 class="font-display text-4xl font-light leading-[1.08] tracking-tight text-ink sm:text-6xl md:text-7xl lg:text-8xl">
      Fortune 500 craft. <br />
      <span class="italic font-normal text-clay">Main Street soul.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:mt-7 sm:text-xl">
      I build websites for businesses across Fresno and the Central Valley — by hand, one at a time. I&rsquo;m Adam
      Youssef, based in Clovis. You get my mobile number, not a ticket queue.
    </p>

    <div
      class="relative mx-auto mt-10 max-w-md overflow-hidden rounded-2xl border border-ink/15 bg-linen/90 p-6 text-left shadow-lg backdrop-blur sm:p-7"
    >
      <div class="flex items-center justify-between border-b border-dashed border-ink/20 pb-3">
        <span class="font-mono text-[11px] uppercase tracking-widest text-stone">{landing.title}</span>
        <span class="font-mono text-[11px] uppercase tracking-widest text-stone">{landing.timeline}</span>
      </div>
      <div class="flex items-baseline gap-3 pt-4">
        <span class="font-serif text-5xl font-bold tracking-tight text-ink">${landing.price?.toLocaleString()}</span>
        {
          landing.regularPrice && (
            <span class="font-serif text-xl text-stone line-through">${landing.regularPrice.toLocaleString()}</span>
          )
        }
      </div>
      <ul class="mt-4 space-y-2 border-t border-dashed border-ink/20 pt-4">
        {
          ["One page, live in a week", "Yours on day one", "No monthly required"].map((line) => (
            <li class="flex gap-2.5 text-sm text-ink-soft">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-olive" />
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
      <a
        href="tel:+15595753014"
        class="inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-full bg-ink px-8 py-4 text-base font-semibold text-linen shadow-xl transition-all duration-300 hover:bg-clay hover:shadow-clay/25 focus:outline-none focus:ring-2 focus:ring-clay focus:ring-offset-2"
      >
        <Icon name="phone" class="h-4.5 w-4.5" />
        <span>Call (559) 575-3014</span>
      </a>
      <a
        href={formatSmsUri(landing.title)}
        class="inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-full border border-ink/25 bg-paper/60 px-8 py-4 text-base font-semibold text-ink backdrop-blur transition-all duration-300 hover:border-clay hover:text-clay focus:outline-none focus:ring-2 focus:ring-clay focus:ring-offset-2"
      >
        <Icon name="message" class="h-4.5 w-4.5" />
        <span>Text me instead</span>
      </a>
    </div>

    <div class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
      <a href="#pricing" class={linkClass}>See what everything costs</a>
      <a href="#work" class={linkClass}>See two sites I built</a>
      <a href={BRIEF_MAILTO} class={linkClass}>Send details in writing</a>
    </div>

    <div
      class="mx-auto mt-14 grid max-w-3xl grid-cols-3 divide-x divide-ink/10 rounded-2xl border border-ink/10 bg-linen/70 p-4 shadow-sm backdrop-blur sm:p-6"
    >
      {
        [
          ["100/100", "PageSpeed score"],
          ["1 Week", "To live"],
          ["100%", "Asset Ownership"],
        ].map(([value, label]) => (
          <div class="flex flex-col items-center justify-center px-2 sm:px-6">
            <span class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-4xl">{value}</span>
            <span class="mt-1 text-xs font-medium uppercase tracking-wider text-stone">{label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
