---
import { Image } from "astro:assets";
import Mark from "./Mark.astro";
import AmbientVideo from "./AmbientVideo.astro";
import lenses from "@/assets/lenses.jpg";
import { hero, ticker } from "@/data/fovea";
import { PRICING_CONSTANTS, formatSmsUri } from "@/data/calculator";

const price = PRICING_CONSTANTS.tiers.landing.price;
// Row sizes in container units, so the chart fits its column at any width. Biggest row first, like a Snellen chart.
// Row 1 is sized from the width left after its acuity label, so an ~8-letter word never overflows a 320px phone.
const sizes = [
  "clamp(1.9rem,calc((100cqi - 4.5rem) * 0.155),10.2rem)",
  "clamp(1.8rem,11cqi,8.3rem)",
  "clamp(1.6rem,8.8cqi,6.3rem)",
  "clamp(1.3rem,6.6cqi,4.7rem)",
  "clamp(1.1rem,5cqi,3.4rem)",
  "clamp(0.8rem,2.5cqi,1.62rem)",
  "clamp(0.72rem,1.8cqi,1.08rem)",
  "clamp(0.6875rem,1.35cqi,0.85rem)",
];
---

<section id="hero" class="paper relative overflow-hidden pt-28 md:pt-32" aria-labelledby="hero-title">
  <!-- ambient light -->
  <AmbientVideo name="curtains" class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-[.22] mix-blend-luminosity" />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-bone/60 via-bone/80 to-bone" aria-hidden="true"></div>
  <Mark class="pointer-events-none absolute top-1/3 -right-24 h-[560px] w-[560px] text-ink/[0.045]" />

  <div class="relative mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-10">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-ink/12 pb-4">
      <span class="label flex items-center gap-2 text-vermilion">
        <span class="anim-blink inline-block h-1.5 w-1.5 rounded-full bg-vermilion" aria-hidden="true"></span>
        {hero.status}
      </span>
      <span class="label text-muted">{hero.line}</span>
      <span class="label hidden text-muted sm:block">{hero.area}</span>
      <span class="label ml-auto hidden text-muted lg:block">{hero.chartNo}</span>
    </div>

    <h1 id="hero-title" class="sr-only">{hero.h1}</h1>

    <div class="grid grid-cols-1 gap-10 pt-8 pb-4 lg:grid-cols-12 lg:gap-8">
      <!-- the chart -->
      <div class="lg:col-span-8">
        <div class="chart select-none" data-chart data-cursor aria-hidden="true">
          {
            ["chart-base", "chart-sharp"].map((layer) => (
              <div class={layer}>
                {hero.chart.map((row, i) => (
                  <div
                    class:list={["flex items-end justify-between gap-4 border-b border-ink/[0.07] leading-[0.9]", i >= 5 ? "py-[0.5em]" : "py-[0.2em]"]}
                    style={`font-size:${sizes[i]}`}
                  >
                    {row.link && layer === "chart-base" ? (
                      <a
                        href="#book"
                        tabindex="-1"
                        class="optotype min-w-0 leading-[1.6] text-ink underline decoration-vermilion decoration-2 underline-offset-[3px] [overflow-wrap:anywhere] hover:text-vermilion"
                      >
                        {row.text}
                      </a>
                    ) : (
                      <span class:list={["optotype min-w-0 [overflow-wrap:anywhere]", row.accent ? "text-vermilion" : "text-ink", i >= 5 && "leading-[1.15]"]}>{row.text}</span>
                    )}
                    <span class="tightnum shrink-0 pb-[0.2em] text-[0.6875rem] text-muted">{row.acuity}</span>
                  </div>
                ))}
              </div>
            ))
          }
          <svg class="glasses" viewBox="0 0 400 150" aria-hidden="true">
            <g class="glasses-tint">
              <circle cx="100" cy="80" r="66"></circle>
              <circle cx="300" cy="80" r="66"></circle>
            </g>
            <g fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round">
              <circle cx="100" cy="80" r="70"></circle>
              <circle cx="300" cy="80" r="70"></circle>
              <path d="M169 68Q200 46 231 68M31 66 6 58M369 66 394 58"></path>
            </g>
            <path class="glasses-glare" d="M52 68A50 50 0 0 1 86 32M252 68A50 50 0 0 1 286 32" fill="none" stroke-width="6" stroke-linecap="round"></path>
          </svg>
        </div>

        <!-- controls -->
        <div class="mt-9 flex flex-wrap items-center gap-3 border-t border-ink/12 pt-5">
          <button
            type="button"
            data-lens-toggle
            data-on={`${hero.lensOn} · ${hero.lensHint}`}
            data-off={hero.lensOff}
            aria-pressed="true"
            hidden
            class="group min-h-[48px] items-center gap-3 rounded-full border border-ink/15 py-2 pr-5 pl-3 transition-colors hover:border-ink/40"
          >
            <span class="lens-switch" aria-hidden="true"></span>
            <span data-lens-label class="label text-ink-2 group-hover:text-ink">{hero.lensOn} · {hero.lensHint}</span>
          </button>
          <a href="#exam" class="label inline-flex min-h-[48px] items-center text-muted underline decoration-ink/25 underline-offset-4 transition-colors hover:text-vermilion">
            {hero.examLink}
          </a>
        </div>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2 sm:text-xl">{hero.pitch}</p>
        <p class="label mt-4 text-ink">{hero.priceLine(price)}</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={formatSmsUri()} class="wipe inline-flex min-h-[52px] items-center justify-center rounded-full bg-ink px-7 text-bone">
            <span class="label relative z-10">{hero.ctaText}</span>
          </a>
          <a
            href="#pricing"
            class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-ink/25 px-7 text-ink transition-colors hover:border-ink"
          >
            <span class="label">{hero.ctaPrices} ↓</span>
          </a>
        </div>
        <p data-reading data-template={hero.reading} hidden class="label mt-5 text-muted"></p>
      </div>

      <!-- the dispensary shelf -->
      <div class="relative lg:col-span-4">
        <div class="relative mx-auto w-full max-w-[380px] lg:mr-0 lg:ml-auto">
          <div class="relative overflow-hidden rounded-t-full border border-ink/15 bg-bone-2">
            <AmbientVideo name="pour" class="h-[330px] w-full object-cover opacity-90" />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bone/70 via-transparent to-bone/25" aria-hidden="true"></div>
            <div class="absolute inset-x-0 bottom-0 flex items-end justify-between p-4" aria-hidden="true">
              <span class="label text-ink">{hero.figure.caption}</span>
              <span class="tightnum text-[0.6875rem] text-ink">{hero.figure.meta}</span>
            </div>
          </div>

          <figure class="anim-float relative z-10 -mt-16 w-full rotate-[-2.6deg] border border-ink/12 bg-bone p-2 shadow-[0_30px_60px_-40px_rgba(22,35,44,.7)] sm:w-[86%] lg:-ml-[14%]">
            <Image src={lenses} alt={hero.plate.alt} widths={[360, 720]} sizes="(min-width: 640px) 330px, calc(100vw - 2rem)" class="h-[210px] w-full object-cover" />
            <figcaption class="flex items-center justify-between px-1 pt-2 pb-1">
              <span class="label text-muted">{hero.plate.caption}</span>
              <span class="tightnum text-[0.6875rem] text-muted">{hero.plate.meta}</span>
            </figcaption>
          </figure>

          <!-- rotating seal -->
          <div class="pointer-events-none absolute -top-6 -left-14 hidden h-[132px] w-[132px] place-items-center lg:grid" aria-hidden="true">
            <svg viewBox="0 0 132 132" class="anim-spin-slow h-full w-full">
              <path id="seal-path" d="M66,66 m-49,0 a49,49 0 1,1 98,0 a49,49 0 1,1 -98,0" fill="none"></path>
              <circle cx="66" cy="66" r="64" fill="none" stroke="#16232c" stroke-opacity=".18"></circle>
              <circle cx="66" cy="66" r="34" fill="none" stroke="#b93b21" stroke-opacity=".55" stroke-dasharray="2 3"></circle>
              <text fill="#16232c" fill-opacity=".75" style="font-family:var(--font-mono);font-size:10px;letter-spacing:2.4px;text-transform:uppercase">
                <!-- textLength = the circle's circumference, so any seal text wraps exactly once. -->
                <textPath href="#seal-path" textLength="307" lengthAdjust="spacing">{hero.seal}</textPath>
              </text>
            </svg>
            <span class="absolute grid h-11 w-11 place-items-center rounded-full bg-vermilion text-bone">
              <Mark class="h-4 w-4" />
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ticker -->
  <div class="relative mt-6 overflow-hidden border-y border-ink/12 bg-vermilion py-2.5 text-bone">
    <div class="anim-marquee flex w-max">
      {
        [0, 1].map((copy) => (
          <ul class="label flex shrink-0 items-center gap-8 pr-8" aria-hidden={copy === 1 ? "true" : undefined}>
            {ticker(price).map((item) => (
              <li class="flex items-center gap-8 whitespace-nowrap">
                {item}
                <Mark class="h-2.5 w-2.5 shrink-0" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* The glasses sit at (--lx, --ly): the point between the lenses, level with their centers. --gw is their width.
     Declared here, used by children, so cqi means the chart's own width. */
  .chart {
    position: relative;
    container-type: inline-size;
    --gw: clamp(200px, 62cqi, 500px);
    --lx: 62%;
    --ly: 30%;
  }
  .chart-sharp {
    display: none;
  }
  .glasses {
    position: absolute;
    left: var(--lx);
    top: var(--ly);
    width: var(--gw);
    translate: -50% -53.3%;
    color: var(--color-ink);
    filter: drop-shadow(0 12px 14px rgb(22 35 44 / 0.2));
    pointer-events: none;
  }
  .glasses-tint {
    fill: rgb(255 255 255 / 0.18);
  }
  .glasses-glare {
    stroke: var(--color-bone);
    opacity: 0.85;
  }
  .chart.glasses-off .glasses {
    display: none;
  }

  /* Glasses mode: only switched on by the script, on devices with a mouse. The chart goes soft, sharp through the lenses,
     like the original's trial lens. */
  .chart.lens-on .chart-base {
    filter: blur(2.6px) saturate(0.9);
    opacity: 0.62;
  }
  .chart.lens-on .chart-sharp {
    /* Lens centers sit a quarter of the frame width either side; 0.162 is the inner rim radius (65/400). */
    --r: calc(var(--gw) * 0.162);
    --dx: calc(var(--gw) * 0.25);
    display: block;
    position: absolute;
    inset: 0;
    mask-image:
      radial-gradient(circle var(--r) at calc(var(--lx) - var(--dx)) var(--ly), #000 98%, transparent),
      radial-gradient(circle var(--r) at calc(var(--lx) + var(--dx)) var(--ly), #000 98%, transparent);
  }
  [data-lens-toggle]:not([hidden]) {
    display: inline-flex;
  }

  .lens-switch {
    position: relative;
    width: 32px;
    height: 16px;
    border-radius: 99px;
    background: var(--color-optic);
    transition: background-color 0.3s;
  }
  .lens-switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 18px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-bone);
    transition: left 0.3s;
  }
  [aria-pressed="false"] .lens-switch {
    background: rgb(22 35 44 / 0.2);
  }
  [aria-pressed="false"] .lens-switch::after {
    left: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* On load, every device: the chart starts blurry, the glasses drop on, and it comes into focus as they land.
       `backwards` holds the blur until then; in glasses mode it settles at that mode's blur instead of sharp. */
    .chart-base {
      animation: focus-pull 0.9s var(--ease-out-expo) 0.85s backwards;
    }
    .glasses {
      animation: glasses-on 0.8s cubic-bezier(0.3, 1.3, 0.6, 1) 0.2s backwards;
    }
    .chart.lens-on .chart-sharp {
      animation: fade-in 0.4s ease-out 0.85s backwards;
    }
  }
  @keyframes focus-pull {
    from {
      filter: blur(7px);
    }
  }
  @keyframes glasses-on {
    from {
      translate: -50% -200%;
      rotate: -10deg;
      opacity: 0;
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  // The glasses follow the pointer, only where there is one. Phones and reduced-motion users get the sharp chart
  // with the glasses resting on it.
  const chart = document.querySelector<HTMLElement>("[data-chart]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-lens-toggle]");
  if (chart && toggle && matchMedia("(hover: hover) and (pointer: fine) and (min-width: 640px) and (prefers-reduced-motion: no-preference)").matches) {
    chart.classList.add("lens-on");
    toggle.hidden = false;
    chart.addEventListener("pointermove", (e) => {
      const r = chart.getBoundingClientRect();
      chart.style.setProperty("--lx", `${e.clientX - r.left}px`);
      chart.style.setProperty("--ly", `${e.clientY - r.top}px`);
    });
    toggle.addEventListener("click", () => {
      const on = chart.classList.toggle("lens-on");
      chart.classList.toggle("glasses-off", !on);
      toggle.setAttribute("aria-pressed", String(on));
      toggle.querySelector("[data-lens-label]")!.textContent = on ? toggle.dataset.on! : toggle.dataset.off!;
    });
  }

  // The real load time of this page on this device, read as eyesight. Hidden if slow or unknown.
  const reading = document.querySelector<HTMLElement>("[data-reading]");
  const type = PerformanceObserver.supportedEntryTypes?.includes("largest-contentful-paint") ? "largest-contentful-paint" : "paint";
  if (reading) {
    new PerformanceObserver((list) => {
      const entry = list.getEntries().at(-1);
      if (!entry) return;
      const s = entry.startTime / 1000;
      if (s > 2.5) return;
      const acuity = s < 1 ? "20/20" : s < 1.8 ? "20/25" : "20/40";
      reading.textContent = reading.dataset.template!.replace("{time}", `${s.toFixed(2)}s`).replace("{acuity}", acuity);
      reading.hidden = false;
    }).observe({ type, buffered: true });
  }
</script>
