---
import Mark from "./Mark.astro";
import SectionHead from "./SectionHead.astro";
import { formatSmsUri } from "@/data/calculator";
import { practice as p } from "@/data/fovea";
---

<section id="about" class="scroll-mt-28 py-24 sm:py-32" aria-labelledby="about-title">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-10">
    <SectionHead id="about-title" {...p.head} />

    <div class="mt-14 grid gap-12 lg:grid-cols-12">
      <div class="space-y-5 text-lg leading-relaxed text-ink-soft lg:col-span-7">
        {p.body.map((para, i) => <p class:list={[i === 0 && "font-display text-[1.7rem] leading-snug text-ink sm:text-3xl"]}>{para}</p>)}
        <a
          href={formatSmsUri()}
          class="!mt-8 inline-flex min-h-[52px] items-center rounded-full bg-ink px-7 text-[0.95rem] font-semibold text-paper transition-colors hover:bg-cobalt"
        >
          Text Adam
        </a>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-[28px] bg-ink p-6 text-paper sm:p-9">
          <div class="flex items-center justify-between">
            <h3 class="text-3xl leading-none">{p.rulesTitle}</h3>
            <Mark class="h-10 w-10 text-paper" />
          </div>
          <ol class="mt-7 space-y-4">
            {
              p.rules.map((rule, i) => (
                <li class="flex gap-4 border-t border-paper/15 pt-4">
                  <span class="optotype text-sm text-paper/60">0{i + 1}</span>
                  <span class="leading-snug">{rule}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
