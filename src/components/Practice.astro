---
import AmbientVideo from "./AmbientVideo.astro";
import { formatSmsUri } from "@/data/calculator";
import { practice as p } from "@/data/fovea";
---

<section id="about" class="relative scroll-mt-28 border-b border-ink/12 bg-bone-2" aria-labelledby="about-title">
  <div class="mx-auto max-w-[1500px] px-4 py-20 sm:px-6 md:py-28 lg:px-10">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14">
      <!-- the practice, visually -->
      <div class="relative lg:col-span-5" data-reveal>
        <div class="relative overflow-hidden rounded-t-full border border-ink/15">
          <AmbientVideo name="hands-laptop" label={p.figure.videoLabel} class="h-[400px] w-full object-cover md:h-[480px]" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-bone/20" aria-hidden="true"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-center justify-between p-5" aria-hidden="true">
            <span class="label text-bone">{p.figure.caption}</span>
            <span class="tightnum text-[0.6875rem] text-bone">{p.figure.meta}</span>
          </div>
        </div>

        <div class="absolute top-6 -left-4 hidden rounded-2xl border border-ink/15 bg-bone/95 px-4 py-3 backdrop-blur-md lg:block">
          <span class="label block text-muted">{p.callout.k}</span>
          <span class="font-display text-[20px] leading-none">{p.callout.v}</span>
        </div>
      </div>

      <!-- the words -->
      <div class="lg:col-span-7 lg:pl-4">
        <p class="label flex items-center gap-3 text-muted">
          <span class="tightnum text-vermilion">{p.n}</span>
          <span class="h-px w-8 bg-ink/25" aria-hidden="true"></span>
          {p.label}
        </p>
        <h2 id="about-title" class="mt-5 max-w-[20ch] text-[clamp(2.2rem,5.4vw,4.4rem)] text-ink">
          {p.title[0]}<br />{p.title[1]}
        </h2>

        <div class="mt-8 max-w-[58ch] space-y-5 text-[16.5px] leading-relaxed text-ink-2">
          {p.body.map((para) => <p>{para}</p>)}
          <p class="text-ink">
            {p.closing.text}{" "}
            <span class="accent font-display">{p.closing.accent}</span>
          </p>
        </div>

        <div class="mt-10 rounded-[24px] border border-ink/15 bg-bone p-6 sm:p-8">
          <p class="label flex items-center gap-3 text-vermilion">
            <span class="h-px w-5 bg-vermilion" aria-hidden="true"></span>
            {p.rulesTitle}
          </p>
          <ol class="mt-5 grid gap-3.5">
            {
              p.rules.map((rule, i) => (
                <li class="flex items-baseline gap-4">
                  <span class="tightnum text-[0.6875rem] text-muted">{String(i + 1).padStart(2, "0")}</span>
                  <span class="text-[15.5px] leading-snug text-ink">{rule}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <a href={formatSmsUri()} class="wipe mt-8 inline-flex min-h-[52px] items-center rounded-full bg-ink px-7 text-bone">
          <span class="label relative z-10">{p.cta}</span>
        </a>
      </div>
    </div>
  </div>
</section>
