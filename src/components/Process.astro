---
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";
import { processSteps } from "@/data/process";
import { exam } from "@/data/fovea";

const n = processSteps.length;
const pad = (i: number) => String(i).padStart(2, "0");
// Radios drive everything: which lens sits under the index, which panel shows. Generated per step count.
const css = processSteps
  .map(
    (_, i) =>
      `.exam:has(#step-${i}:checked){--w:${(-i * 360) / n}deg}` +
      `.exam:has(#step-${i}:checked) [data-step-panel="${i}"]{display:block}` +
      `.exam:has(#step-${i}:checked) [data-readout="${i}"]{display:inline}` +
      `.exam:has(#step-${i}:checked) .dial-lens[for="step-${i}"] .face{background:var(--color-cobalt);border-color:var(--color-cobalt);color:var(--color-paper)}` +
      `.exam:has(#step-${i}:focus-visible) .dial-lens[for="step-${i}"] .face{outline:2px solid var(--color-paper);outline-offset:4px}`
  )
  .join("");
---

<section id="process" class="scroll-mt-28 bg-ink py-24 text-paper sm:py-32" aria-labelledby="process-title">
  <style is:inline set:html={css}></style>
  <div class="exam mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-10">
    <SectionHead id="process-title" tone="dark" {...exam.head} />

    {processSteps.map((s, i) => <input type="radio" name="step" id={`step-${i}`} class="sr-only" checked={i === 0} aria-label={s.title} />)}

    <div class="mt-14 grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="dial relative mx-auto aspect-square w-full max-w-[380px]">
          <div class="absolute inset-[14%] rounded-full border border-dashed border-paper/30" aria-hidden="true"></div>
          <span class="absolute top-[3%] left-1/2 h-0 w-0 -translate-x-1/2 border-x-[9px] border-t-[12px] border-x-transparent border-t-cobalt" aria-hidden="true"></span>
          <div class="dial-spin absolute inset-0">
            {
              processSteps.map((s, i) => (
                <label for={`step-${i}`} class="dial-lens cursor-pointer" style={`--a:${(i * 360) / n}deg`}>
                  <span class="face optotype flex h-full w-full items-center justify-center rounded-full border-2 border-paper/40 bg-ink text-lg text-paper transition-colors hover:border-paper">
                    {pad(i + 1)}
                  </span>
                  <span class="sr-only">{s.title}</span>
                </label>
              ))
            }
          </div>
          <div class="absolute inset-[32%] flex flex-col items-center justify-center rounded-full bg-paper text-ink" aria-hidden="true">
            {
              processSteps.map((_, i) => (
                <span data-readout={i} class="optotype text-3xl">
                  {pad(i + 1)}
                </span>
              ))
            }
            <span class="label mt-1 text-muted">
              {exam.of} {pad(n)}
            </span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7" aria-live="polite">
        {
          processSteps.map((s, i) => (
            <article data-step-panel={i} class="step-panel rounded-[28px] bg-paper p-6 text-ink sm:p-10">
              <p class="label text-cobalt">
                {pad(i + 1)} · {s.duration}
              </p>
              <h3 class="mt-3 text-[2.2rem] leading-none sm:text-5xl">{s.title}</h3>
              <p class="mt-5 leading-relaxed text-ink-soft">{s.description}</p>
              <p class="label mt-7 text-muted">{exam.youGet}</p>
              <ul class="mt-3 space-y-2">
                {s.deliverables.map((d) => (
                  <li class="flex gap-2.5">
                    <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-cobalt" />
                    <span class="leading-snug">{d}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-8 flex justify-between gap-3 border-t border-ink/10 pt-5">
                {i > 0 ? (
                  <label for={`step-${i - 1}`} class="label inline-flex min-h-[48px] cursor-pointer items-center rounded-full border border-ink/20 px-5 hover:border-ink">
                    ← {exam.prev}
                  </label>
                ) : (
                  <span />
                )}
                {i < n - 1 && (
                  <label for={`step-${i + 1}`} class="label inline-flex min-h-[48px] cursor-pointer items-center rounded-full bg-ink px-5 text-paper hover:bg-cobalt">
                    {exam.next} →
                  </label>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .step-panel,
  [data-readout] {
    display: none;
  }
  .dial {
    container-type: inline-size;
  }
  .dial-spin {
    transform: rotate(var(--w, 0deg));
    transition: transform 0.9s var(--ease-expo);
  }
  /* Each lens sits on the ring at angle --a, then counter-rotates so its number stays upright. */
  .dial-lens {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18cqi;
    height: 18cqi;
    min-width: 48px;
    min-height: 48px;
    translate: -50% -50%;
    transform: rotate(var(--a)) translateY(-36cqi) rotate(calc(-1 * (var(--a) + var(--w, 0deg))));
    transition: transform 0.9s var(--ease-expo);
  }
</style>
