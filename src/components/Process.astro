---
import Mark from "./Mark.astro";
import SectionHead from "./SectionHead.astro";
import { processSteps } from "@/data/process";
import { exam } from "@/data/fovea";

const n = processSteps.length;
const pad = (i: number) => String(i).padStart(2, "0");
// Radios drive everything: which lens sits under the index, which reading shows. Generated per step count.
const css = processSteps
  .map(
    (_, i) =>
      `.exam:has(#step-${i}:checked){--w:${(-i * 360) / n}deg}` +
      `.exam:has(#step-${i}:checked) [data-step-panel="${i}"]{display:block}` +
      `.exam:has(#step-${i}:checked) [data-readout="${i}"]{display:block}` +
      `.exam:has(#step-${i}:checked) .dial-lens[for="step-${i}"] .face{scale:1.1;border-color:var(--color-ink);background:var(--color-butter);color:var(--color-ink);box-shadow:0 14px 30px -14px rgb(22 35 44/.6)}` +
      `.exam:has(#step-${i}:checked) .dot[for="step-${i}"] span:first-child{width:2.5rem;background:var(--color-vermilion)}` +
      `.exam:has(#step-${i}:focus-visible) .dial-lens[for="step-${i}"] .face{outline:2px solid var(--color-vermilion);outline-offset:4px}`
  )
  .join("");
---

<section id="process" class="graph relative scroll-mt-28 border-b border-ink/12 bg-bone-2" aria-labelledby="process-title">
  <style is:inline set:html={css}></style>
  <div class="exam mx-auto max-w-[1500px] px-4 py-20 sm:px-6 md:py-28 lg:px-10">
    <SectionHead id="process-title" {...exam.head} />

    {processSteps.map((s, i) => <input type="radio" name="step" id={`step-${i}`} class="sr-only" checked={i === 0} aria-label={s.title} />)}

    <div class="grid grid-cols-1 gap-12 pt-12 lg:grid-cols-12 lg:gap-14">
      <!-- the phoropter -->
      <div class="flex items-center justify-center lg:col-span-5" data-reveal>
        <div class="dial relative aspect-square w-full max-w-[430px]">
          <div class="absolute inset-0 rounded-full border border-ink/15 bg-gradient-to-b from-bone to-bone-3 shadow-[inset_0_2px_0_rgba(255,255,255,.8),0_40px_80px_-50px_rgba(22,35,44,.7)]" aria-hidden="true"></div>
          <div class="dial-ring absolute inset-[7%] rounded-full border border-dashed border-ink/20" aria-hidden="true"></div>
          <div class="absolute -top-1 left-1/2 -translate-x-1/2" aria-hidden="true">
            <div class="h-0 w-0 border-x-[7px] border-t-[12px] border-x-transparent border-t-vermilion"></div>
          </div>
          <span class="label absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap text-muted" aria-hidden="true">{exam.nextLens}</span>

          <div class="dial-spin absolute inset-0">
            {
              processSteps.map((s, i) => (
                <label for={`step-${i}`} class="dial-lens cursor-pointer" style={`--a:${(i * 360) / n}deg`}>
                  <span class="face grid h-full w-full place-content-center justify-items-center rounded-full border border-ink/20 bg-bone text-muted transition-all duration-500 hover:border-ink/50">
                    <span class="tightnum text-[0.6875rem]">{exam.lenses[i]}</span>
                    <span class="label mt-1 leading-none">{pad(i + 1)}</span>
                  </span>
                  <span class="sr-only">{s.title}</span>
                </label>
              ))
            }
          </div>

          <div class="absolute top-1/2 left-1/2 grid h-[38%] w-[38%] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-ink/20 bg-ink text-bone" aria-hidden="true">
            <div class="text-center">
              <Mark class="mx-auto h-5 w-5 opacity-90" />
              {
                processSteps.map((_, i) => (
                  <div data-readout={i} class="readout mt-2 font-display text-[clamp(1.4rem,3vw,2rem)] leading-none">
                    {pad(i + 1)}
                  </div>
                ))
              }
              <div class="label mt-1.5 text-bone/70">
                {exam.of} {pad(n)}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- the reading -->
      <div class="lg:col-span-7" aria-live="polite">
        {
          processSteps.map((s, i) => (
            <article data-step-panel={i} class="step-panel relative rounded-[28px] border border-ink/12 bg-bone p-6 sm:p-10">
              <div class="flex items-start justify-between gap-6">
                <div>
                  <p class="label text-vermilion">
                    {exam.lens} {pad(i + 1)} · {exam.lenses[i]}
                  </p>
                  <h3 class="mt-4 text-[clamp(1.9rem,4.2vw,3.4rem)] leading-[1.02] text-ink">{s.title}</h3>
                </div>
                <span class="label hidden shrink-0 rounded-full border border-ink/15 px-3 py-2 text-muted sm:block">{s.duration}</span>
              </div>

              <p class="mt-6 max-w-[60ch] text-[17px] leading-relaxed text-ink-2">{s.description}</p>

              <p class="label mt-8 text-muted">{exam.youGet}</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {s.deliverables.map((d) => (
                  <li class="rounded-2xl bg-bone-2 px-4 py-2.5 text-[14px] leading-snug text-ink-2">{d}</li>
                ))}
              </ul>

              <div class="mt-9 flex items-center justify-end gap-4 border-t border-ink/12 pt-5 sm:justify-between">
                <div class="hidden sm:flex">
                  {processSteps.map((step, k) => (
                    <label for={`step-${k}`} class="dot flex h-12 min-w-12 cursor-pointer items-center justify-center" title={step.title}>
                      <span class="block h-[6px] w-4 rounded-full bg-ink/20 transition-all duration-500 hover:bg-ink/40" />
                      <span class="sr-only">{step.title}</span>
                    </label>
                  ))}
                </div>
                <div class="flex gap-2">
                  <label
                    for={`step-${(i + n - 1) % n}`}
                    class="grid h-12 w-12 cursor-pointer place-items-center rounded-full border border-ink/15 transition-colors hover:border-ink/45"
                  >
                    <span class="text-lg leading-none" aria-hidden="true">←</span>
                    <span class="sr-only">{exam.prev}</span>
                  </label>
                  <label
                    for={`step-${(i + 1) % n}`}
                    class="grid h-12 w-12 cursor-pointer place-items-center rounded-full border border-ink/15 transition-colors hover:border-ink/45"
                  >
                    <span class="text-lg leading-none" aria-hidden="true">→</span>
                    <span class="sr-only">{exam.next}</span>
                  </label>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .step-panel,
  .readout {
    display: none;
  }
  /* As in the original, each step prints out when it comes up. */
  @media (prefers-reduced-motion: no-preference) {
    .step-panel {
      animation: printOut 0.6s var(--ease-out-expo) both;
    }
  }
  .dial {
    container-type: inline-size;
  }
  .dial-ring,
  .dial-spin {
    rotate: var(--w, 0deg);
    transition: rotate 1s var(--ease-out-expo);
  }
  /* Each lens sits on the ring at angle --a, then counter-rotates so its label stays upright. */
  .dial-lens {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20cqi;
    height: 20cqi;
    min-width: 64px;
    min-height: 64px;
    max-width: 88px;
    max-height: 88px;
    translate: -50% -50%;
    transform: rotate(var(--a)) translateY(-36cqi) rotate(calc(-1 * (var(--a) + var(--w, 0deg))));
    transition: transform 1s var(--ease-out-expo);
  }
</style>
