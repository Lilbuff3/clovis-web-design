---
import { processSteps } from "@/data/process";
---

<section id="process" class="scroll-mt-24 border-t border-ink/20 bg-ink py-24 text-linen sm:py-32" aria-labelledby="process-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-reveal>
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-widest text-ember">How it works</span>
        <h2 id="process-title" class="mt-3 font-serif text-3xl font-light tracking-tight text-linen sm:text-5xl">
          Four stages. <br />
          <span class="italic font-normal text-ember">You see every one of them.</span>
        </h2>
      </div>
      <p class="max-w-md text-sm text-stone-light leading-relaxed">
        Each stage ends with something you can look at and keep, so you always know where the project stands.
      </p>
    </div>

    <ol class="mt-20 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        processSteps.map((step) => (
          <li class="relative flex flex-col justify-between rounded-3xl border border-linen/10 bg-ink-soft/40 p-8 transition-all duration-300 hover:border-ember/40 hover:bg-ink-soft/70">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-serif text-4xl font-light text-ember">{step.number}</span>
                <span class="rounded-full border border-linen/15 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-stone-light">
                  {step.duration}
                </span>
              </div>
              <h3 class="mt-6 font-serif text-xl font-bold text-linen">{step.title}</h3>
              <p class="mt-3 text-xs text-stone-light leading-relaxed">{step.description}</p>
            </div>
            <div class="mt-8 border-t border-linen/10 pt-6">
              <span class="block font-mono text-[11px] font-bold uppercase tracking-widest text-ember">You walk away with:</span>
              <ul class="mt-3 space-y-2">
                {step.deliverables.map((item) => (
                  <li class="flex items-start gap-2 text-xs text-stone-light leading-snug">
                    <span class="text-ember font-bold" aria-hidden="true">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-16 rounded-2xl border border-linen/10 bg-ink-soft/30 p-6 text-center">
      <p class="font-mono text-xs text-stone-light sm:text-sm">
        One page: about a week. A multi-page site: three to four weeks.
      </p>
    </div>
  </div>
</section>
